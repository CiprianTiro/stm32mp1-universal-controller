[Unit]
Description=Universal Controller touchscreen UI
# Starts as early in boot as possible (issue #59). An ordinary service is
# held back until the whole base system is up (basic.target: every
# filesystem including /usr/local and its check, the network, ...) --
# measured on the DK2, that put the UI at ~22 s after kernel start, with a
# black screen for the last ~6 s. The UI needs none of it:
#   - the display: it waits for the real display driver itself (see
#     display::wait_for_display_driver), and until then the boot image
#     from U-Boot stays on screen;
#   - the touch panel: it keeps looking for it until it appears;
#   - backend_daemon: it shows a welcome screen and keeps retrying the
#     connection (ws_client.rs) until the backend answers.
# DefaultDependencies=no removes that implicit "after basic.target". The
# UI's output still reaches the journal: systemd orders any service that
# logs to it after the journal's socket automatically.
DefaultDependencies=no
# DefaultDependencies=no also removes the usual shutdown handling, so it's
# added back by hand: stop the UI when the system shuts down or reboots,
# and before it goes on to unmount filesystems.
Conflicts=shutdown.target
Before=shutdown.target

[Service]
ExecStart=/usr/bin/ui-layer
# If it crashes, wait a couple of seconds before restarting instead of
# systemd's default (near-instant) restart, so a failure that repeats
# doesn't restart in a tight loop and burn CPU. (When a monitor is
# plugged in or out, the UI restarts ITSELF in place, without this delay
# -- see restart_on_other_screen in main.rs, issue #38.)
Restart=on-failure
RestartSec=2

# =====================================================================
# Least privilege (issue #37)
# =====================================================================
# The UI only draws on the screen (touchscreen or monitor), reads the
# touch panel, and talks to
# backend_daemon on 127.0.0.1. Everything else is taken away, so a bug in
# it (or in a library it uses) gives an attacker nothing more than that.
# `systemd-analyze security ui-layer` on the board rates the result.
#
# None of these settings may make the UI wait for anything (it starts
# right at the beginning of boot, see above). That's why PrivateTmp= is
# NOT used: it makes a service wait for systemd-tmpfiles-setup, i.e. for
# the whole filesystem setup -- exactly the wait #59 removed. It isn't
# needed either: with ProtectSystem=strict below, /tmp is read-only for the
# UI, so it can't put anything there, let alone share it.

# --- Who it runs as --------------------------------------------------
# Its own user, created by the ui-layer recipe: no login, no home, owns no
# files at all. video: /dev/dri/card0 (the display, issue #38);
# input: /dev/input/event* (the touch panel). Both device nodes belong to
# those groups.
User=hubui
Group=hubui
SupplementaryGroups=video input
UMask=0077

# --- Privileges ------------------------------------------------------
# No capabilities at all, and no way to gain any.
CapabilityBoundingSet=
NoNewPrivileges=yes
RestrictSUIDSGID=yes

# --- Files -----------------------------------------------------------
# Everything read-only; it writes nothing (only into the screen's memory,
# through the DRM device).
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible

# --- Devices ---------------------------------------------------------
# Only the display (the "drm" devices, /dev/dri/card0 -- the UI draws
# through DRM/KMS since issue #38) and input devices, plus the harmless
# standard ones (/dev/null, /dev/urandom, ...). By device TYPE, not by
# path: at the time the UI starts, the final /dev/dri/card0 may not exist
# yet (it waits for the display driver itself), but the kernel registers
# the types themselves at boot.
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-input rw

# --- Network ---------------------------------------------------------
# It only ever talks to backend_daemon on 127.0.0.1:8080. Any other
# address is blocked by the kernel for this service, whatever the UI
# tries: it can't reach the LAN or the internet at all.
IPAddressDeny=any
IPAddressAllow=localhost
# Unix sockets for the journal (its log messages); netlink (issue #38)
# for libinput, which listens to udev's announcements of input devices
# being plugged in or out (a USB mouse or keyboard).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# --- Kernel and system -----------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# Memory can't be both writable and executable (the software renderer
# draws with plain CPU code; nothing is generated at run time).
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# Only ordinary services' system calls, minus the privileged ones and those
# changing priorities/limits; native 32-bit ARM only.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
