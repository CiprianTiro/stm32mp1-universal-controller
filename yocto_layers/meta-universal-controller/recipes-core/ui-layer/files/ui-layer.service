[Unit]
Description=Universal Controller touchscreen UI
# Starts as early in boot as possible (issue #59). An ordinary service is
# held back until the whole base system is up (basic.target: every
# filesystem including /usr/local and its check, the network, ...) --
# measured on the DK2, that put the UI at ~22 s after kernel start, with a
# black screen for the last ~6 s. The UI needs none of it:
#   - the display: it waits for the real display driver itself (see
#     fb_platform::wait_for_display_driver), and until then the boot image
#     from U-Boot stays on screen;
#   - the touch panel: it keeps looking for it until it appears;
#   - backend_daemon: it shows a welcome screen and keeps retrying the
#     connection (ws_client.rs) until the backend answers.
# DefaultDependencies=no removes that implicit "after basic.target". The
# UI's output still reaches the journal: systemd orders any service that
# logs to it after the journal's socket automatically.
DefaultDependencies=no
# DefaultDependencies=no also removes the usual shutdown handling, so it's
# added back by hand: stop the UI when the system shuts down or reboots,
# and before it goes on to unmount filesystems.
Conflicts=shutdown.target
Before=shutdown.target

[Service]
ExecStart=/usr/bin/ui-layer
# If it crashes, wait a couple of seconds before restarting instead of
# systemd's default (near-instant) restart, so a failure that repeats
# doesn't restart in a tight loop and burn CPU.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
