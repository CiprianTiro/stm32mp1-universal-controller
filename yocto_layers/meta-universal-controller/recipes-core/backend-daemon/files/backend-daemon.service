[Unit]
Description=Universal Controller hub daemon
After=network.target

[Service]
# Optional per-device settings, e.g. MQTT_BROKER_HOST=192.168.1.10 (cloud
# sync stays off until that's set -- see linux_a7/backend_daemon/src/mqtt.rs).
# The leading "-" means a missing file is fine. Edit it on the board and
# `systemctl restart backend-daemon`; no rebuild needed.
EnvironmentFile=-/etc/default/backend-daemon
ExecStart=/usr/bin/backend-daemon
Restart=on-failure

[Install]
WantedBy=multi-user.target
