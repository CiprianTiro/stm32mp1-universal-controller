<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  The hub's LAN API, announced over mDNS (issue #48): the phone app browses
  for _uchub._tcp and finds the hub without a typed address -- also when
  the router hands out a new IP. Only where to connect is announced; who
  the hub is stays proven by its pinned certificate (ws.rs, tls.rs).
  %h = the host name (stm32mp1).
-->
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service>
    <type>_uchub._tcp</type>
    <port>8443</port>
    <txt-record>path=/ws</txt-record>
    <txt-record>protocol=2</txt-record>
  </service>
</service-group>
