# ==============================================================================
# 1. YOCTO PROJECT & BITBAKE ARTIFACTS (CRITICAL)
# ==============================================================================
# Never track the massive temporary compilation directory, caches, or downloads
yocto_layers/build/tmp/
yocto_layers/build/sstate-cache/
yocto_layers/build/cache/
yocto_layers/build/downloads/

# Ignore BitBake execution locks and state flags
yocto_layers/build/*.lock
yocto_layers/build/pseudodone
yocto_layers/build/bitbake.lock

# If you run QEMU, ignore temporary runtime network/tap initialization files
yocto_layers/build-qemu/qemu-boot*
yocto_layers/build-qemu/tmp/
yocto_layers/build-qemu/sstate-cache/
yocto_layers/build-qemu/cache/
yocto_layers/build-qemu/downloads/

# Ignore BitBake execution locks and state flags
yocto_layers/build/*.lock
yocto_layers/build/pseudodone
yocto_layers/build/bitbake.lock

# Ignore BitBake execution locks and state flags
yocto_layers/build-qemu/*.lock
yocto_layers/build-qemu/pseudodone
yocto_layers/build-qemu/bitbake.lock

# ==============================================================================
# 2. UPSTREAM / BASE LAYERS (MANAGED VIA GIT SUBMODULES)
# ==============================================================================
# DO NOT uncomment these. Submodules must remain unignored so Git can track 
# their tracking configuration files and 40-character revision pointer hashes.
#yocto_layers/poky/
#yocto_layers/meta-st-stm32mp/
#yocto_layers/meta-openembedded/
#yocto_layers/meta-rust/

# ==============================================================================
# 3. RUST APPLICATION LAYER (linux_a7/)
# ==============================================================================
# Ignore Cargo compilation target directories (which easily grow to gigabytes)
linux_a7/backend_daemon/target/
linux_a7/ui_layer/target/
**/target/

# Ignore Cargo backup files generated during edits
**/*.rs.bk

# ==============================================================================
# 4. EMBEDDED C/C++ FIRMWARE (firmware_m4/)
# ==============================================================================
# STM32CubeIDE / GNU ARM Toolchain build outputs
firmware_m4/**/Debug/
firmware_m4/**/Release/
firmware_m4/**/*.o
firmware_m4/**/*.su
firmware_m4/**/*.d
firmware_m4/**/*.elf
firmware_m4/**/*.bin
firmware_m4/**/*.hex
firmware_m4/**/*.map
firmware_m4/**/*.list

# Toolchain / IDE project specific user configurations
firmware_m4/**/*.launch
firmware_m4/.metadata/
firmware_m4/**/.settings/

# ==============================================================================
# 5. IDE, EDITORS, AND SYSTEM ARTIFACTS
# ==============================================================================
# VS Code
.vscode/
*.code-workspace

# JetBrains (CLion / PyCharm / IntelliJ)
.idea/

# Vim/Emacs swap and backup files
*~
*.swp
*.swo
*.bak

# Operating System system-generated files
.DS_Store
Thumbs.db

# Docker container volume state leftovers
yocto_layers/.docker/