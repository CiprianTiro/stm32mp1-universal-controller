{
  "$comment": "Shelly Plug S Gen3 (and other Shelly Gen2+ plugs with one switch): open local HTTP API (pattern P1), run by the GENERIC http adapter -- this file is all there is. Format: wiki Device-Templates.",
  "format": 1,
  "id": "shelly-plug-gen3",
  "version": 2,
  "name": "Shelly plug",
  "category": "plugs",
  "description": "Shelly Plug S Gen3 smart plug, with power metering. It must already be on your WiFi (Shelly app, or its own web page), with no password set on the device.",
  "adapter": "http",
  "capabilities": ["switch", "energy", "sensor"],
  "inputs": [
    {
      "id": "host",
      "type": "text",
      "label": "Address",
      "hint": "The plug's IP address (Shelly app: the plug's settings > Device information), e.g. 192.168.1.70",
      "validate": { "pattern": "host" }
    }
  ],
  "discovery": [
    {
      "method": "mdns",
      "service": "_shelly._tcp",
      "match": { "txt.app": "PlugSG3" },
      "fill": { "host": "{address}", "shelly_id": "{name}" }
    },
    {
      "method": "port_probe",
      "port": 80,
      "manufacturers": ["Espressif", "Shelly"],
      "get": "/shelly",
      "match": { "json.app": "PlugSG3" },
      "fill": { "host": "{address}", "shelly_id": "{json.id}" }
    }
  ],
  "setup": [
    { "id": "guided", "label": "Find it automatically", "steps": [ { "type": "discover" }, { "type": "test" } ] },
    { "id": "advanced", "label": "Enter the address", "steps": [ { "type": "form", "fields": ["host"] }, { "type": "test" } ] }
  ],
  "errors": {
    "unsupported": "That address answers, but not as a Shelly plug without a password. If you set a password on the plug, remove it in the Shelly app (Settings > Authentication) -- the hub can't use one yet."
  },
  "identity": "{shelly_id}",
  "defaults": { "name": "Plug" },
  "http": {
    "poll_s": 10,
    "state": [
      {
        "path": "/rpc/Switch.GetStatus?id=0",
        "read": {
          "switch.on": "output",
          "energy.power_w": "apower",
          "energy.voltage_v": "voltage",
          "energy.current_a": "current",
          "energy.energy_kwh": { "path": "aenergy.total", "scale": 0.001 },
          "sensor.temperature": { "path": "temperature.tC", "unit": "°C" }
        }
      }
    ],
    "commands": {
      "switch": { "path": "/rpc/Switch.Set?id=0&on={on}" }
    },
    "probe": {
      "path": "/shelly",
      "require": { "auth_en": "false" },
      "values": { "shelly_id": "id", "mac": "mac" },
      "name": "name",
      "summary": "Shelly {model}, firmware {ver}"
    }
  }
}
