// ir_remote.slint -- the remote of a device run by an IR blaster (issue
// #42): the buttons the person TAUGHT it, and teaching new ones.
//
// A TV's remote (remote.slint) has a fixed layout, because the hub knows
// what a TV's buttons are. An IR device's buttons are whatever was taught,
// with whatever names ("Power", "Red", "Brighter"), so they're a grid of
// labelled buttons in the order they were taught.
//
// Teaching is an ACTION like pressing (backend_daemon: remote learn /
// forget / rename): this page only reports taps, main.rs sends them, and
// the button list comes back through the device's `remote` capability.
//
// Five views on one page (`view`):
//   0  the buttons (tap = press), "Teach a button", "Edit buttons"
//   1  edit: each button with Rename / Teach again / Delete
//   2  naming a new button (keyboard)
//   3  waiting for the button on the original remote
//   4  renaming a button (keyboard)

import { Theme } from "theme.slint";
import { PageHeader, ActionButton } from "common.slint";
import { Keyboard } from "keyboard.slint";

// One taught button: as wide as the grid gives it, thumb-sized.
component IrKey inherits Rectangle {
    in property <string> text;
    callback clicked();

    border-radius: Theme.radius-medium;
    border-width: 1px;
    border-color: Theme.outline;
    background: touch.pressed ? Theme.surface-pressed : Theme.surface;
    Text {
        x: Theme.space-s;
        width: parent.width - 2 * Theme.space-s;
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-subtitle;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A text being typed (a button's name), shown like a field with a cursor.
component NameField inherits Rectangle {
    in property <string> text;
    height: Theme.touch-height;
    border-radius: Theme.radius-medium;
    background: Theme.surface;
    border-width: 2px;
    border-color: Theme.accent;
    Text {
        x: Theme.space-l;
        width: parent.width - 2 * Theme.space-l;
        text: root.text + "|";
        color: Theme.text;
        font-size: Theme.font-heading;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component IrRemotePage inherits Rectangle {
    in property <string> device-name;
    in property <[string]> buttons;
    // "" when the blaster can be used, else a sentence saying why not.
    in property <string> status;
    // One line under the title: what just happened (ok) or went wrong.
    in property <string> message;
    in property <bool> message-ok;
    in-out property <int> view: 0;
    // The name being typed (views 2 and 4).
    in-out property <string> text;
    // The button being taught (view 3) or renamed (view 4).
    in-out property <string> selected;
    callback back();
    callback press(string);
    callback learn(string);
    callback forget(string);
    callback rename(string, string);
    callback backspace();

    // Edit view: the button whose Delete was tapped once ("Delete?").
    property <string> confirm-delete;
    // The buttons grid: columns by width (3 on the portrait touchscreen,
    // more on a monitor), fixed-height keys.
    property <int> columns: max(2, floor(self.width / 150px));
    property <length> key-height: 72px;

    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-s;

        PageHeader {
            title: view == 1 ? "Edit buttons"
                : view == 2 ? "Teach a button"
                : view == 3 ? "Teach \u{201C}" + root.selected + "\u{201D}"
                : view == 4 ? "Rename \u{201C}" + root.selected + "\u{201D}"
                : root.device-name;
            back => {
                if (view == 4) {
                    view = 1;
                } else if (view != 0) {
                    view = 0;
                } else {
                    root.back();
                }
            }
        }
        if status != "": Text {
            text: status;
            color: Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        if message != "" && view != 3: Text {
            text: message;
            color: message-ok ? Theme.ok : Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        // ---- 0: the buttons ----
        if view == 0 && buttons.length == 0: Text {
            vertical-stretch: 1;
            text: "No buttons yet.\n\nTap \u{201C}Teach a button\u{201D}, give it a name, then press that button on the device's original remote, pointed at the IR blaster.";
            color: Theme.text-muted;
            font-size: Theme.font-subtitle;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        if view == 0 && buttons.length > 0: Flickable {
            vertical-stretch: 1;
            content-height: ceil(buttons.length / columns) * (key-height + Theme.space-s);
            for name[i] in buttons: IrKey {
                // Row-major grid by hand: Slint's GridLayout can't be
                // filled from a list.
                x: (i - floor(i / columns) * columns) * (parent.width + Theme.space-s) / columns;
                y: floor(i / columns) * (key-height + Theme.space-s);
                width: (parent.width + Theme.space-s) / columns - Theme.space-s;
                height: key-height;
                text: name;
                clicked => {
                    root.press(name);
                }
            }
        }
        if view == 0: HorizontalLayout {
            spacing: Theme.space-s;
            ActionButton {
                text: "+ Teach a button";
                primary: true;
                horizontal-stretch: 1;
                enabled: status == "";
                clicked => {
                    root.text = "";
                    view = 2;
                }
            }
            if buttons.length > 0: ActionButton {
                text: "Edit buttons";
                horizontal-stretch: 1;
                clicked => {
                    confirm-delete = "";
                    view = 1;
                }
            }
        }

        // ---- 1: edit ----
        if view == 1: Flickable {
            vertical-stretch: 1;
            content-height: buttons.length * (Theme.touch-height + Theme.space-s);
            for name[i] in buttons: HorizontalLayout {
                y: i * (Theme.touch-height + Theme.space-s);
                width: parent.width;
                height: Theme.touch-height;
                spacing: Theme.space-s;
                Text {
                    text: name;
                    color: Theme.text;
                    font-size: Theme.font-subtitle;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                ActionButton {
                    text: "Rename";
                    clicked => {
                        root.selected = name;
                        root.text = name;
                        view = 4;
                    }
                }
                ActionButton {
                    text: "Teach again";
                    enabled: status == "";
                    clicked => {
                        root.selected = name;
                        root.learn(name);
                        view = 3;
                    }
                }
                ActionButton {
                    text: confirm-delete == name ? "Delete?" : "Delete";
                    destructive: true;
                    clicked => {
                        if (confirm-delete == name) {
                            confirm-delete = "";
                            root.forget(name);
                        } else {
                            confirm-delete = name;
                        }
                    }
                }
            }
        }
        if view == 1: ActionButton {
            text: "Done";
            primary: true;
            clicked => {
                view = 0;
            }
        }

        // ---- 2 / 4: typing a name ----
        if view == 2 || view == 4: Text {
            text: view == 2
                ? "Name the button as you'll look for it, e.g. Power, Red, Brighter."
                : "The new name:";
            color: Theme.text-muted;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        if view == 2 || view == 4: NameField {
            text: root.text;
        }
        if view == 2 || view == 4: Rectangle {
            vertical-stretch: 1;
        }
        if view == 2 || view == 4: Keyboard {
            text <=> root.text;
            max-length: 24;
            backspace => {
                root.backspace();
            }
            done => {
                if (root.text != "") {
                    if (view == 2) {
                        root.selected = root.text;
                        root.learn(root.text);
                        view = 3;
                    } else {
                        root.rename(root.selected, root.text);
                        view = 1;
                    }
                }
            }
        }

        // ---- 3: waiting for the remote ----
        if view == 3: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: Theme.space-xl;
            Text {
                text: "Press \u{201C}" + root.selected + "\u{201D} on the original remote now.";
                color: Theme.text;
                font-size: Theme.font-title;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: "Point it at the IR blaster, from close by, and press the button once. Waiting up to 30 seconds\u{2026}";
                color: Theme.text-muted;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if view == 3: ActionButton {
            text: "Cancel";
            clicked => {
                view = 0;
            }
        }
    }
}
