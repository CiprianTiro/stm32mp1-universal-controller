// ir_remote.slint -- the remote of a device run by an IR blaster (issue
// #42): the buttons the person TAUGHT it, and teaching new ones.
//
// A TV's remote (remote.slint) has a fixed layout, because the hub knows
// what a TV's buttons are. An IR device's buttons are whatever was taught,
// with whatever names ("Power", "Red", "Brighter"), so they're a grid of
// labelled buttons in the order they were taught.
//
// Teaching is an ACTION like pressing (backend_daemon: remote learn /
// forget / rename): this page only reports taps, main.rs sends them, and
// the button list comes back through the device's `remote` capability.
//
// Five views on one page (`view`):
//   0  the buttons (tap = press), "Teach a button", "Edit buttons"
//   1  edit: each button with Rename / Teach again / Delete
//   2  naming a new button (keyboard)
//   3  waiting for the button on the original remote
//   4  renaming a button (keyboard)
// and the code finder for a lost remote (issue #82, main.rs ir_finder.rs):
//   5  pick the device's type      6  pick its brand
//   7  "Did the device react?" after its Power
//   8  "Did it react again?" after a second button

import { Theme } from "theme.slint";
import { PageHeader, ActionButton } from "common.slint";
import { Keyboard } from "keyboard.slint";
import { RemoteItem } from "remote.slint";

// A device's buttons laid out as a remote (issue #82, main.rs
// ir_layout.rs): rows of keys; a key without a name is a gap.
export struct IrKeyItem {
    name: string,
    label: string,
}
export struct IrRow {
    keys: [IrKeyItem],
}

// One taught button: as wide as the grid gives it, thumb-sized.
component IrKey inherits Rectangle {
    in property <string> text;
    callback clicked();

    border-radius: Theme.radius-medium;
    border-width: 1px;
    border-color: Theme.outline;
    background: touch.pressed ? Theme.surface-pressed : Theme.surface;
    Text {
        x: Theme.space-s;
        width: parent.width - 2 * Theme.space-s;
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-subtitle;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A row of the finder's type or brand list.
component ListRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    callback clicked();

    border-radius: Theme.radius-medium;
    background: touch.pressed ? Theme.surface-pressed : Theme.surface;
    HorizontalLayout {
        padding-left: Theme.space-l;
        padding-right: Theme.space-l;
        spacing: Theme.space-s;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-subtitle;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.detail;
            color: Theme.text-muted;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A text being typed (a button's name), shown like a field with a cursor.
component NameField inherits Rectangle {
    in property <string> text;
    height: Theme.touch-height;
    border-radius: Theme.radius-medium;
    background: Theme.surface;
    border-width: 2px;
    border-color: Theme.accent;
    Text {
        x: Theme.space-l;
        width: parent.width - 2 * Theme.space-l;
        text: root.text + "|";
        color: Theme.text;
        font-size: Theme.font-heading;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component IrRemotePage inherits Rectangle {
    in property <string> device-name;
    in property <[string]> buttons;
    // The same buttons as a remote's rows, and the ones not in them (no
    // rows: just the grid of `buttons`).
    in property <[IrRow]> layout;
    in property <[string]> others;
    // Every button with what it shows ("VOLUME_UP" as "Vol +"), for the
    // edit view.
    in property <[IrKeyItem]> labelled;
    // "" when the blaster can be used, else a sentence saying why not.
    in property <string> status;
    // One line under the title: what just happened (ok) or went wrong.
    in property <string> message;
    in property <bool> message-ok;
    in-out property <int> view: 0;
    // The name being typed (views 2 and 4).
    in-out property <string> text;
    // The button being taught (view 3) or renamed (view 4).
    in-out property <string> selected;
    // The finder (views 5-8): the list on show, waiting for the hub, and
    // the question after a code was sent.
    in property <[RemoteItem]> items;
    in property <bool> loading;
    in property <string> question;
    in property <string> detail;
    callback back();
    callback press(string);
    callback learn(string);
    callback forget(string);
    callback rename(string, string);
    callback backspace();
    callback find();
    callback pick(string, string);
    callback answer(bool);
    callback resend();

    // Edit view: the button whose Delete was tapped once ("Delete?").
    property <string> confirm-delete;
    // The buttons grid: columns by width (3 on the portrait touchscreen,
    // more on a monitor), fixed-height keys.
    property <int> columns: max(2, floor(self.width / 150px));
    property <length> key-height: 72px;

    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-s;

        PageHeader {
            title: view == 1 ? "Edit buttons"
                : view == 2 ? "Teach a button"
                : view == 3 ? "Teach \u{201C}" + root.selected + "\u{201D}"
                : view == 4 ? "Rename \u{201C}" + root.selected + "\u{201D}"
                : view == 5 ? "What kind of device?"
                : view == 6 ? "Which brand?"
                : view == 7 || view == 8 ? "Finding the codes"
                : root.device-name;
            back => {
                if (view == 4) {
                    view = 1;
                } else if (view == 6) {
                    view = 5;
                } else if (view == 7 || view == 8) {
                    view = 6;
                } else if (view != 0) {
                    view = 0;
                } else {
                    root.back();
                }
            }
        }
        if status != "": Text {
            text: status;
            color: Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        if message != "" && view != 3 && view != 5 && view != 6: Text {
            text: message;
            color: message-ok ? Theme.ok : Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        // ---- 0: the buttons ----
        if view == 0 && buttons.length == 0: Text {
            vertical-stretch: 1;
            text: "No buttons yet.\n\nTap \u{201C}Teach a button\u{201D}, give it a name, then press that button on the device's original remote, pointed at the IR blaster.\n\nNo remote? The hub knows the codes of many devices: tap \u{201C}Find its codes\u{201D}.";
            color: Theme.text-muted;
            font-size: Theme.font-subtitle;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        if view == 0 && layout.length > 0: Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.space-s;
                for row in layout: HorizontalLayout {
                    spacing: Theme.space-s;
                    height: key-height;
                    for key in row.keys: Rectangle {
                        horizontal-stretch: 1;
                        if key.name != "": IrKey {
                            width: parent.width;
                            height: parent.height;
                            text: key.label;
                            clicked => {
                                root.press(key.name);
                            }
                        }
                    }
                }
                if others.length > 0: Text {
                    text: "More buttons";
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                }
                // The rest as the usual grid.
                if others.length > 0: Rectangle {
                    height: ceil(others.length / columns) * (key-height + Theme.space-s);
                    for name[i] in others: IrKey {
                        x: (i - floor(i / columns) * columns) * (parent.width + Theme.space-s) / columns;
                        y: floor(i / columns) * (key-height + Theme.space-s);
                        width: (parent.width + Theme.space-s) / columns - Theme.space-s;
                        height: key-height;
                        text: name;
                        clicked => {
                            root.press(name);
                        }
                    }
                }
            }
        }
        if view == 0 && layout.length == 0 && buttons.length > 0: Flickable {
            vertical-stretch: 1;
            content-height: ceil(buttons.length / columns) * (key-height + Theme.space-s);
            for name[i] in buttons: IrKey {
                // Row-major grid by hand: Slint's GridLayout can't be
                // filled from a list.
                x: (i - floor(i / columns) * columns) * (parent.width + Theme.space-s) / columns;
                y: floor(i / columns) * (key-height + Theme.space-s);
                width: (parent.width + Theme.space-s) / columns - Theme.space-s;
                height: key-height;
                text: name;
                clicked => {
                    root.press(name);
                }
            }
        }
        if view == 0: HorizontalLayout {
            spacing: Theme.space-s;
            ActionButton {
                text: "+ Teach a button";
                primary: true;
                horizontal-stretch: 1;
                enabled: status == "";
                clicked => {
                    root.text = "";
                    view = 2;
                }
            }
            if buttons.length > 0: ActionButton {
                text: "Edit buttons";
                horizontal-stretch: 1;
                clicked => {
                    confirm-delete = "";
                    view = 1;
                }
            }
        }

        if view == 0: ActionButton {
            text: buttons.length == 0 ? "No remote? Find its codes" : "Add buttons from the code library";
            enabled: status == "";
            clicked => {
                root.find();
            }
        }

        // ---- 1: edit ----
        if view == 1: Flickable {
            vertical-stretch: 1;
            content-height: labelled.length * (Theme.touch-height + Theme.space-s);
            for item[i] in labelled: HorizontalLayout {
                y: i * (Theme.touch-height + Theme.space-s);
                width: parent.width;
                height: Theme.touch-height;
                spacing: Theme.space-s;
                Text {
                    text: item.label;
                    color: Theme.text;
                    font-size: Theme.font-subtitle;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                ActionButton {
                    text: "Rename";
                    clicked => {
                        root.selected = item.name;
                        root.text = item.name;
                        view = 4;
                    }
                }
                ActionButton {
                    text: "Teach again";
                    enabled: status == "";
                    clicked => {
                        root.selected = item.name;
                        root.learn(item.name);
                        view = 3;
                    }
                }
                ActionButton {
                    text: confirm-delete == item.name ? "Delete?" : "Delete";
                    destructive: true;
                    clicked => {
                        if (confirm-delete == item.name) {
                            confirm-delete = "";
                            root.forget(item.name);
                        } else {
                            confirm-delete = item.name;
                        }
                    }
                }
            }
        }
        if view == 1: ActionButton {
            text: "Done";
            primary: true;
            clicked => {
                view = 0;
            }
        }

        // ---- 2 / 4: typing a name ----
        if view == 2 || view == 4: Text {
            text: view == 2
                ? "Name the button as you'll look for it, e.g. Power, Red, Brighter."
                : "The new name:";
            color: Theme.text-muted;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        if view == 2 || view == 4: NameField {
            text: root.text;
        }
        if view == 2 || view == 4: Rectangle {
            vertical-stretch: 1;
        }
        if view == 2 || view == 4: Keyboard {
            text <=> root.text;
            max-length: 24;
            backspace => {
                root.backspace();
            }
            done => {
                if (root.text != "") {
                    if (view == 2) {
                        root.selected = root.text;
                        root.learn(root.text);
                        view = 3;
                    } else {
                        root.rename(root.selected, root.text);
                        view = 1;
                    }
                }
            }
        }

        // ---- 3: waiting for the remote ----
        if view == 3: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: Theme.space-xl;
            Text {
                text: "Press \u{201C}" + root.selected + "\u{201D} on the original remote now.";
                color: Theme.text;
                font-size: Theme.font-title;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: "Point it at the IR blaster, from close by, and press the button once. Waiting up to 30 seconds\u{2026}";
                color: Theme.text-muted;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if view == 3: ActionButton {
            text: "Cancel";
            clicked => {
                view = 0;
            }
        }

        // ---- 5 / 6: the finder's type and brand lists ----
        if (view == 5 || view == 6) && loading: Text {
            vertical-stretch: 1;
            text: "Loading\u{2026}";
            color: Theme.text-muted;
            font-size: Theme.font-subtitle;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if (view == 5 || view == 6) && !loading && message != "": Text {
            text: message;
            color: message-ok ? Theme.ok : Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        if (view == 5 || view == 6) && !loading: Flickable {
            vertical-stretch: 1;
            content-height: items.length * (Theme.touch-height + Theme.space-s);
            for item[i] in items: ListRow {
                y: i * (Theme.touch-height + Theme.space-s);
                width: parent.width;
                height: Theme.touch-height;
                label: item.label;
                detail: item.detail;
                clicked => {
                    root.pick(item.id, item.label);
                }
            }
        }

        // ---- 7 / 8: did it react? ----
        if view == 7 || view == 8: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: Theme.space-xl;
            Text {
                text: loading && question == "" ? "Looking up the codes\u{2026}" : question;
                color: Theme.text;
                font-size: Theme.font-title;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if !(loading && question == ""): Text {
                text: detail;
                color: Theme.text-muted;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if (view == 7 || view == 8) && question != "": HorizontalLayout {
            spacing: Theme.space-s;
            ActionButton {
                text: "No";
                horizontal-stretch: 1;
                enabled: !loading;
                clicked => {
                    root.answer(false);
                }
            }
            ActionButton {
                text: "Yes, it did";
                primary: true;
                horizontal-stretch: 1;
                enabled: !loading;
                clicked => {
                    root.answer(true);
                }
            }
        }
        if (view == 7 || view == 8) && question != "": ActionButton {
            text: "Send again";
            enabled: !loading;
            clicked => {
                root.resend();
            }
        }
    }
}
