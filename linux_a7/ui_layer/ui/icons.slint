        colorize: root.color;
    }
    if kind == "home": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/home.svg");
        colorize: root.color;
    }
    if kind == "device": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/device.svg");
        colorize: root.color;
    }
    if kind == "settings": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/settings.svg");
        colorize: root.color;
    }
    if kind == "add": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/add.svg");
        colorize: root.color;
    }
    if kind == "wifi": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/wifi.svg");
        colorize: root.color;
    }
    if kind == "wifi-off": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/wifi-off.svg");
        colorize: root.color;
    }
    if kind == "ethernet": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/ethernet.svg");
        colorize: root.color;
    }
    if kind == "hotspot": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/hotspot.svg");
        colorize: root.color;
    }
    if kind == "play": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/play.svg");
        colorize: root.color;
    }
    if kind == "automation": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/automation.svg");
        colorize: root.color;
    }
    if kind == "scenes": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/scenes.svg");
        colorize: root.color;
    }
    if kind == "power-button": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/power-button.svg");
        colorize: root.color;
    }
    if kind == "palette": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/palette.svg");
        colorize: root.color;
    }
    if kind == "brightness": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/brightness.svg");
        colorize: root.color;
    }
    if kind == "night": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/night.svg");
        colorize: root.color;
    }
    if kind == "sun": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/sun.svg");
        colorize: root.color;
    }
    if kind == "back": Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/back.svg");
        colorize: root.color;
    }
    if kind == "info": Image {
