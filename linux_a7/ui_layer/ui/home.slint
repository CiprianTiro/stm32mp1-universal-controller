// home.slint -- the hub's home screen pieces (issue #95, second round):
// the bottom navigation bar, round icon buttons, the scene chips, and the
// big brightness slider of a device's controls page.
//
// The layout follows wall-panel dashboards (Apple Home on an iPad, Google
// Nest Hub): a clock at the top, scenes as one-tap chips, devices as
// tiles, and the four main places always one tap away at the bottom.

import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

// A round, icon-only button for the top bar: thumb-sized.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.text;
    callback clicked();

    width: Theme.touch-height;
    height: Theme.touch-height;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.surface-pressed : Theme.surface;
    Icon {
        kind: root.icon;
        color: root.tint;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One of the bottom bar's places.
component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> current;
    callback clicked();

    // The current place: its icon on an accent pill (Material 3).
    VerticalLayout {
        alignment: center;
        spacing: Theme.space-xxs;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 28px;
                border-radius: self.height / 2;
                background: current ? Theme.accent : (touch.pressed ? Theme.surface-pressed : transparent);
                animate background { duration: 150ms; }
                Icon {
                    kind: root.icon;
                    color: current ? Theme.on-accent : Theme.text-muted;
                }
            }
        }
        Text {
            text: root.label;
            color: current ? Theme.text : Theme.text-muted;
            font-size: Theme.font-caption;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The bottom bar: Home, Scenes, Automations, Settings. `current` is the
// place shown (0-3). `vertical` (issue #107, a landscape screen): a rail
// down the left edge instead -- the height a bar would take is what a
// landscape screen has least of.
export component NavBar inherits Rectangle {
    in property <int> current;
    in property <bool> vertical: false;
    // Issue #107, the rail: the hub's connection at its foot -- a green
    // dot, or red and "Offline" when the hub can't be reached.
    in property <bool> online: true;
    callback go(int);

    background: Theme.surface;
    // A hairline above it (on its right as a rail).
    Rectangle {
        x: vertical ? parent.width - 1px : 0;
        y: 0;
        width: vertical ? 1px : parent.width;
        height: vertical ? parent.height : 1px;
        background: Theme.outline;
    }
    if vertical: VerticalLayout {
        alignment: center;
        spacing: Theme.space-l;
        NavItem {
            height: 64px;
            icon: "home";
            label: "Home";
            current: root.current == 0;
            clicked => {
                root.go(0);
            }
        }
        NavItem {
            height: 64px;
            icon: "scenes";
            label: "Scenes";
            current: root.current == 1;
            clicked => {
                root.go(1);
            }
        }
        NavItem {
            height: 64px;
            icon: "automation";
            label: "Rules";
            current: root.current == 2;
            clicked => {
                root.go(2);
            }
        }
        NavItem {
            height: 64px;
            icon: "settings";
            label: "Settings";
            current: root.current == 3;
            clicked => {
                root.go(3);
            }
        }
    }
    if vertical: VerticalLayout {
        y: parent.height - self.height - Theme.space-l;
        height: self.preferred-height;
        spacing: Theme.space-xxs;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.online ? Theme.ok : Theme.error;
            }
        }
        Text {
            text: root.online ? "Hub" : "Offline";
            color: root.online ? Theme.text-muted : Theme.error;
            font-size: Theme.font-caption;
            horizontal-alignment: center;
        }
    }
    if !vertical: HorizontalLayout {
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        NavItem {
            icon: "home";
            label: "Home";
            current: root.current == 0;
            clicked => {
                root.go(0);
            }
        }
        NavItem {
            icon: "scenes";
            label: "Scenes";
            current: root.current == 1;
            clicked => {
                root.go(1);
            }
        }
        NavItem {
            icon: "automation";
            label: "Automations";
            current: root.current == 2;
            clicked => {
                root.go(2);
            }
        }
        NavItem {
            icon: "settings";
            label: "Settings";
            current: root.current == 3;
            clicked => {
                root.go(3);
            }
        }
    }
}

// Issue #107: a scene on the landscape home screen -- a full-width
// rounded button: its sparkle in an accent circle, its name, a small play
// mark at the end. `running`: waiting for it to finish (the play mark
// becomes "...").
export component SceneButton inherits Rectangle {
    in property <string> text;
    in property <bool> running;
    callback clicked();

    height: 52px;
    border-radius: Theme.radius-medium * 2;
    background: touch.pressed || running ? Theme.surface-pressed : Theme.surface;
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-m;
        spacing: Theme.space-m;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: self.height / 2;
                background: Theme.accent.mix(Theme.surface, 0.25);
                Icon {
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    kind: "scenes";
                    color: Theme.accent;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            if !running: Icon {
                width: 18px;
                height: 18px;
                kind: "play";
                color: Theme.text-muted;
            }
            if running: Text {
                text: "\u{2026}";
                color: Theme.text-muted;
                font-size: Theme.font-body;
            }
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Issue #107: a scene on the landscape home screen's left side -- a small
// rounded tile (two per row): its sparkle in an accent circle, top left,
// and its name at the bottom. While it runs: the circle fills and the
// name says so.
export component SceneTile inherits Rectangle {
    in property <string> text;
    in property <bool> running;
    callback clicked();

    border-radius: Theme.radius-medium * 2;
    background: touch.pressed ? Theme.surface-pressed
        : running ? Theme.accent.mix(Theme.surface, 0.18) : Theme.surface;
    animate background { duration: 150ms; }
    // Compact: the sparkle beside the name (two rows fit under the clock).
    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: self.height / 2;
                background: running ? Theme.accent : Theme.accent.mix(Theme.surface, 0.22);
                Icon {
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    kind: "scenes";
                    color: running ? Theme.on-accent : Theme.accent;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: running ? root.text + " \u{2026}" : root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A scene as a chip: tap = run it. `running`: waiting for it to finish.
export component SceneChip inherits Rectangle {
    in property <string> text;
    in property <bool> running;
    callback clicked();

    height: 44px;
    border-radius: self.height / 2;
    background: touch.pressed || running ? Theme.surface-pressed : Theme.surface;
    border-width: 1px;
    border-color: Theme.outline;
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-l;
        spacing: Theme.space-xs;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: self.height / 2;
                background: Theme.accent;
                Icon {
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    kind: "play";
                    color: Theme.on-accent;
                }
            }
        }
        Text {
            text: running ? root.text + " \u{2026}" : root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The controls page's brightness: a wide pill filled up to the level in
// the light's own colour, the % on it -- slide anywhere along it. Like
// devices.slint's LevelBar the command goes out once, when the finger
// lifts, and the chosen value stays until the device confirms (at most
// 2 s).
export component BigLevel inherits Rectangle {
    in property <int> level;
    in property <color> tint: Theme.accent;
    in property <bool> enabled: true;
    in property <string> icon: "brightness";
    callback set(int);

    property <int> drag-level: -1;
    property <int> pending: -1;
    property <int> shown: drag-level >= 0 ? drag-level : (pending >= 0 ? pending : level);
    // Issue #107: the light follows the finger WHILE it's down (as in
    // Apple Home and the phone app): where the finger is, every 150 ms at
    // most -- never a request per pixel.
    property <int> live-sent: -1;
    Timer {
        interval: 150ms;
        running: drag-level >= 0;
        triggered => {
            if (drag-level != live-sent && drag-level != level) {
                live-sent = drag-level;
                set(drag-level);
            }
        }
    }

    changed level => {
        pending = -1;
    }
    Timer {
        interval: 2s;
        running: pending >= 0;
        triggered => {
            pending = -1;
        }
    }

    height: 64px;
    border-radius: Theme.radius-medium * 2;
    background: Theme.surface-pressed;
    clip: true;

    // The filled part.
    Rectangle {
        x: 0;
        width: parent.width * max(shown, 0) / 100;
        background: enabled ? root.tint : Theme.text-muted;
        opacity: enabled ? 1 : 0.5;
    }
    HorizontalLayout {
        padding-left: Theme.space-l;
        padding-right: Theme.space-l;
        spacing: Theme.space-s;
        VerticalLayout {
            alignment: center;
            Icon {
                kind: root.icon;
                color: Theme.text;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: shown + " %";
            color: Theme.text;
            font-size: Theme.font-heading;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        function level-at(x: length) -> int {
            return max(1, min(100, round(x / self.width * 100)));
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                drag-level = level-at(self.mouse-x);
            } else if (event.kind == PointerEventKind.up) {
                if (drag-level >= 0 && drag-level != level && drag-level != live-sent) {
                    pending = drag-level;
                    set(drag-level);
                } else if (drag-level >= 0) {
                    pending = drag-level;
                }
                drag-level = -1;
                live-sent = -1;
            }
        }
        moved => {
            if (self.pressed) {
                drag-level = level-at(self.mouse-x);
            }
        }
    }
}

// Issue #107: the landscape screen's brightness -- a tall pill filled from
// the bottom in the light's colour, the level and a bulb on it (the phone
// app's control, Apple Home's). Like BigLevel it follows the finger and
// sends while it moves (every 150 ms at most), then once more on release.
export component PillLevel inherits Rectangle {
    in property <int> level;
    in property <color> tint: Theme.accent;
    in property <color> on-tint: Theme.on-accent;
    in property <bool> enabled: true;
    callback set(int);

    property <int> drag-level: -1;
    property <int> pending: -1;
    property <int> live-sent: -1;
    property <int> shown: drag-level >= 0 ? drag-level : (pending >= 0 ? pending : level);
    changed level => {
        pending = -1;
    }
    Timer {
        interval: 2s;
        running: pending >= 0;
        triggered => {
            pending = -1;
        }
    }
    Timer {
        interval: 150ms;
        running: drag-level >= 0;
        triggered => {
            if (drag-level != live-sent && drag-level != level) {
                live-sent = drag-level;
                set(drag-level);
            }
        }
    }

    property <length> radius: self.width * 0.32;
    property <length> fill: self.height * max(shown, 0) / 100;
    property <color> fill-color: enabled ? root.tint : Theme.text-muted.mix(Theme.surface, 0.5);
    border-radius: radius;
    background: Theme.surface;
    // The filled part, from the bottom: a rounded piece for the bottom
    // corners and a square one above it (the software renderer doesn't
    // round what a rounded parent clips).
    if fill > 0: Rectangle {
        y: parent.height - self.height;
        height: min(fill, 2 * radius);
        border-radius: radius;
        background: fill-color;
    }
    if fill > radius: Rectangle {
        y: parent.height - fill;
        height: fill - radius;
        background: fill-color;
    }
    VerticalLayout {
        alignment: end;
        padding-bottom: Theme.space-l;
        spacing: Theme.space-xs;
        Text {
            text: shown + " %";
            color: shown > 14 && enabled ? root.on-tint : Theme.text;
            font-size: Theme.font-title;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Icon {
                kind: "light";
                color: shown > 14 && enabled ? root.on-tint : Theme.text-muted;
            }
        }
    }
    TouchArea {
        enabled: root.enabled;
        function level-at(y: length) -> int {
            return max(1, min(100, round((1 - y / self.height) * 100)));
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                drag-level = level-at(self.mouse-y);
            } else if (event.kind == PointerEventKind.up) {
                if (drag-level >= 0 && drag-level != level && drag-level != live-sent) {
                    set(drag-level);
                }
                if (drag-level >= 0) {
                    pending = drag-level;
                }
                drag-level = -1;
                live-sent = -1;
            }
        }
        moved => {
            if (self.pressed) {
                drag-level = level-at(self.mouse-y);
            }
        }
    }
}
