// devices.slint -- the device list on the main screen (issue #34).
//
// Every device is drawn from its CAPABILITIES alone -- there is no code
// here for "a lamp" or "the LED": a switch capability gets a toggle, a
// dimmer a level bar, a color a swatch, a sensor its readings; a cover
// open / stop / close, a climate its mode and target, a lock its state,
// energy what's drawn (issue #77). A device
// type the UI has never heard of works as long as it's built from these.
// main.rs turns backend_daemon's devices into DeviceItem rows and sends the
// commands; like everything in ui_layer, nothing here changes a device's
// state by itself -- it only shows what the backend reports.

import { Theme } from "theme.slint";
import { ActionButton, Choice } from "common.slint";

// One of a TV's inputs (issue #40).
export struct MediaInputItem {
    id: string,
    label: string,
}

// Issue #85: one colour a fixed-colour light can show (a chip on its
// card): "#FF0000" as sent back when tapped, and for drawing.
export struct ColorChip {
    hex: string,
    color: color,
}

// One device, flattened for display. The has-* flags say which
// capabilities it has; the other fields are only meaningful when their
// flag is set.
// Issue #74: a choice a vacuum offers (fan "max" shown as "Max"), one of
// its rooms, one of its wearing parts.
export struct ModeItem {
    value: string,
    label: string,
}

export struct VacuumRoomItem {
    id: int,
    name: string,
}

export struct VacuumPartItem {
    id: string,
    name: string,
    // Percent of its life left.
    left: int,
}

// Issue #74: one of a device's own on/off settings.
export struct OptionItem {
    id: string,
    name: string,
    on: bool,
    // A choice option (night vision: auto / on / off): its value and the
    // choices; none = an on/off toggle.
    value: string,
    choices: [ModeItem],
}

export struct DeviceItem {
    id: string,
    name: string,
    room: string,
    has-switch: bool,
    on: bool,
    has-dimmer: bool,
    level: int,
    has-color: bool,
    color: color,
    // e.g. "#FF8800" or "2700 K"
    color-text: string,
    // Issue #85: the only colours it can show (an IR LED strip), as chips
    // instead of the text; empty = any colour.
    palette: [ColorChip],
    // Issue #85: the remote buttons that make it brighter / dimmer one
    // step ("" = none): - and + on the card.
    brightness-up: string,
    brightness-down: string,
    // e.g. "temperature 21.5 °C   humidity 40 %"; empty = no sensor
    sensor-text: string,
    // Issue #40: "" (fine, or not known), "Offline", "Needs pairing again".
    // A card with a status is drawn dimmed: its values may be stale.
    status: string,
    // Offers "Pair again" right on the card (unauthorized + its type can).
    can-reauth: bool,
    // A TV's sound and source (media capability).
    has-media: bool,
    volume: int,
    muted: bool,
    input: string,
    inputs: [MediaInputItem],
    // Issue #44: a remote (opens the Remote page), and what's on screen
    // ("Live TV \u{2022} 5 Pro TV", "Netflix").
    has-remote: bool,
    // A remote that learns (an IR blaster's, issue #42): usable whatever
    // the hub assumes about on/off (issue #85: an IR light's "off" is only
    // a guess).
    remote-learns: bool,
    now-playing: string,
    // ---- Issue #77 ----
    // A cover: position 0-100 (-1 = not known); can it go to any position
    // (a blind) or only open / close / stop (a garage door); "Opening",
    // "Closing" or "" while still.
    has-cover: bool,
    cover-position: int,
    cover-can-position: bool,
    cover-moving: string,
    // A climate device: its mode and the modes it offers ("off", "heat"
    // ...), the target and its range/step, as numbers to step with and as
    // text ("21.5 °C"); the room temperature ("" if it doesn't measure);
    // fan speed and the ones it offers (none = no fan setting).
    has-climate: bool,
    climate-mode: string,
    climate-modes: [string],
    climate-target: float,
    climate-target-text: string,
    climate-min: float,
    climate-max: float,
    climate-step: float,
    climate-current-text: string,
    climate-fan: string,
    climate-fans: [string],
    // A lock: "locked", "unlocked", "jammed", "unknown".
    has-lock: bool,
    lock-state: string,
    // What a metering device draws: "40.2 W \u{2022} 1.23 kWh"; "" = none.
    energy-text: string,
    // ---- Issue #74 ----
    // A robot vacuum: its state ("docked", "cleaning", "returning",
    // "paused", "idle", "error") and its line ("Charging \u{2022} 85 %",
    // or what's wrong).
    has-vacuum: bool,
    vacuum-state: string,
    vacuum-text: string,
    // Its suction, mopping water and mop route: the current one and the
    // choices it offers (none = it has no such setting).
    vacuum-fan: string,
    vacuum-fans: [ModeItem],
    vacuum-water: string,
    vacuum-waters: [ModeItem],
    vacuum-mop: string,
    vacuum-mops: [ModeItem],
    // "This run: 14.5 m² \u{2022} 21 min", "" if not known.
    vacuum-run-text: string,
    vacuum-rooms: [VacuumRoomItem],
    vacuum-parts: [VacuumPartItem],
    // "272 cleanings \u{2022} 6977 m² \u{2022} 118 h" and "Quiet 22:00-08:00".
    vacuum-totals-text: string,
    vacuum-quiet-text: string,
    // Its map can be shown (turned on at setup; app.slint draws it).
    vacuum-has-map: bool,
    // The device's own settings (a plug's status light...), as toggles.
    options: [OptionItem],
    // Issue #43: a camera that gives pictures (app.slint shows them); one
    // that pans and tilts, and its saved positions (value = its token).
    has-camera: bool,
    camera-ptz: bool,
    camera-presets: [ModeItem],
}

// One wearing part: name, a bar of its life left, Reset (tapped twice:
// it's for after the part was replaced).
component PartRow inherits HorizontalLayout {
    in property <VacuumPartItem> part;
    callback reset();
    property <bool> confirm: false;
    spacing: Theme.space-s;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: Theme.space-xxs;
        Text {
            text: part.name + "  " + part.left + " % left";
            color: part.left <= 10 ? Theme.error : Theme.text;
            font-size: Theme.font-caption;
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.surface-pressed;
            Rectangle {
                x: 0;
                width: parent.width * clamp(part.left, 0, 100) / 100;
                border-radius: 3px;
                background: part.left <= 10 ? Theme.error : Theme.accent;
            }
        }
    }
    ActionButton {
        text: confirm ? "Replaced?" : "Reset";
        clicked => {
            if (confirm) {
                confirm = false;
                root.reset();
            } else {
                confirm = true;
            }
        }
    }
}

// On/off, big enough for a finger.
export component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);

    width: 64px;
    height: 34px;
    border-radius: self.height / 2;
    background: on ? Theme.accent : Theme.outline;

    Rectangle {
        width: 28px;
        height: 28px;
        border-radius: self.height / 2;
        y: 3px;
        x: on ? parent.width - self.width - 3px : 3px;
        background: Theme.knob;
        animate x { duration: 120ms; }
    }

    TouchArea {
        clicked => {
            toggled(!on);
        }
    }
}

// A level from 0 to 100. Shows the device's real level, except while a
// finger is on it (then the finger's position). The command goes out once,
// when the finger lifts -- not for every pixel of a drag, which would flood
// the backend (and the flash, which saves every change).
//
// Between lifting the finger and the backend's confirmation there are a
// few milliseconds in which `level` is still the OLD value; showing it
// made the knob visibly jump back and forth (seen on the DK2). So the
// chosen value is kept on screen ("pending") until `level` changes -- or,
// if the command was refused and nothing changes, for at most 2 s, after
// which the real level shows again.
component LevelBar inherits Rectangle {
    in property <int> level;
    // false: greyed out and not touchable (e.g. a lamp that's switched
    // off); it still shows the level the device will have when turned on.
    in property <bool> enabled: true;
    callback set(int);

    // -1 = not being dragged / nothing pending.
    property <int> drag-level: -1;
    property <int> pending: -1;
    // What the bar shows: the finger's position while dragging, then the
    // released value until confirmed, otherwise the device's level.
    // `out`: the row's "%" text shows the same number, so it follows the
    // finger too instead of only changing after release.
    out property <int> shown: drag-level >= 0 ? drag-level : (pending >= 0 ? pending : level);

    // The confirmation arrived (or someone else changed it): show the truth.
    changed level => {
        pending = -1;
    }

    Timer {
        interval: 2s;
        running: pending >= 0;
        triggered => {
            pending = -1;
        }
    }

    height: 40px;

    // The track, and the filled part.
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 8px;
        border-radius: Theme.radius-small;
        background: Theme.outline;
        Rectangle {
            x: 0;
            width: parent.width * shown / 100;
            border-radius: Theme.radius-small;
            background: enabled ? Theme.accent : Theme.text-muted;
        }
    }

    // The knob.
    Rectangle {
        width: 26px;
        height: 26px;
        border-radius: self.height / 2;
        x: (parent.width - self.width) * shown / 100;
        y: (parent.height - self.height) / 2;
        background: enabled ? Theme.knob : Theme.text-muted;
        // An outline, so the knob stays visible where the bar isn't filled
        // (issue #39: in the light theme the knob and the card are both
        // white).
        border-width: 1px;
        border-color: Theme.outline;
    }

    touch := TouchArea {
        enabled: root.enabled;
        // Finger position -> 0..100.
        function level-at(x: length) -> int {
            return max(0, min(100, round(x / self.width * 100)));
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                drag-level = level-at(self.mouse-x);
            } else if (event.kind == PointerEventKind.up) {
                if (drag-level >= 0) {
                    // Released at the level it already has: nothing to
                    // send, and nothing will arrive to clear `pending`.
                    if (drag-level != level) {
                        pending = drag-level;
                        set(drag-level);
                    }
                }
                drag-level = -1;
            }
        }
        moved => {
            if (self.pressed) {
                drag-level = level-at(self.mouse-x);
            }
        }
    }
}

export component DeviceRow inherits Rectangle {
    in property <DeviceItem> item;
    // Issue #95: shown on a device's controls page, under its own name,
    // state, power button and brightness -- which this card then leaves
    // out.
    in property <bool> in-sheet;
    callback set-switch(string, bool);
    callback set-level(string, int);
    // Issue #40: the TV's volume/mute/input -- all three, as the media
    // capability is set as a whole.
    callback set-media(string, int, bool, string);
    callback open(string);
    callback reauth(string);
    callback open-remote(string);
    // Issue #77.
    callback cover-action(string, string);
    callback set-cover-position(string, int);
    callback set-climate(string, string, float, string);
    callback set-lock(string, bool);
    // Issue #74: (device, action, its argument): start / pause / dock /
    // locate (no argument), set_fan / set_water / set_mop (the choice),
    // clean_rooms (a room id), reset_part (the part's id).
    callback vacuum-action(string, string, string);
    // Issue #74: (device, option id, on) -- or for a choice option,
    // set-option-value (device, option id, value).
    callback set-option(string, string, bool);
    callback set-option-value(string, string, string);
    // Issue #43: (device, pan, tilt) one step; (device, preset token).
    callback camera-move(string, float, float);
    callback camera-preset(string, string);
    // Issue #85: a palette colour tapped; a remote button pressed (an IR
    // light's brightness steps).
    callback set-color(string, string);
    callback press(string, string);

    // The lock's "Unlock Front door?" question is showing.
    property <bool> asking-unlock: false;

    border-radius: in-sheet ? Theme.radius-medium * 2 : Theme.radius-medium;
    background: Theme.surface;
    // Not reachable: dimmed (its values may be stale).
    opacity: item.status == "" ? 1 : 0.6;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-xs;
        // In the grid (issue #38) a card can be taller than its content --
        // a row is as tall as its tallest card. Content then stays at the
        // top instead of spreading out.
        alignment: start;

        if !in-sheet: HorizontalLayout {
            spacing: Theme.space-m;
            // The name: tap for the device's details (issue #40). The
            // TouchArea is a sibling OVER the texts, not inside their
            // layout: inside, it would be one more (zero-height) row of it
            // -- nothing to tap (seen on the DK2).
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: item.name;
                        color: Theme.text;
                        font-size: Theme.font-subtitle;
                        overflow: elide;
                    }
                    if item.room != "" || item.status != "": Text {
                        text: item.status != "" ? item.status + (item.room == "" ? "" : " \u{2022} " + item.room) : item.room;
                        color: item.status != "" ? Theme.error : Theme.text-muted;
                        font-size: Theme.font-caption;
                    }
                }
                TouchArea {
                    clicked => {
                        root.open(item.id);
                    }
                }
            }
            if item.can-reauth: VerticalLayout {
                alignment: center;
                ActionButton {
                    text: "Pair again";
                    clicked => {
                        root.reauth(item.id);
                    }
                }
            }
            if item.has-color: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: self.height / 2;
                    background: item.color;
                    border-width: 1px;
                    border-color: Theme.outline;
                }
            }
            if item.has-switch: VerticalLayout {
                alignment: center;
                Toggle {
                    on: item.on;
                    toggled(on) => {
                        set-switch(item.id, on);
                    }
                }
            }
        }

        if item.has-dimmer && !in-sheet: HorizontalLayout {
            spacing: Theme.space-l;
            bar := LevelBar {
                horizontal-stretch: 1;
                level: item.level;
                // A device that can be switched off: the level only
                // matters (and can only be changed here) while it's on.
                // The backend still accepts a level change while off (an
                // app or automation may preset it); this is a rule of the
                // screen, to avoid "I moved it and nothing happened".
                enabled: !item.has-switch || item.on;
                set(level) => {
                    set-level(item.id, level);
                }
            }
            Text {
                text: bar.shown + "%";
                color: (!item.has-switch || item.on) ? Theme.text : Theme.text-muted;
                font-size: Theme.font-body;
                vertical-alignment: center;
                min-width: 48px;
                horizontal-alignment: right;
            }
        }

        // Issue #85: a light with a few fixed colours (an IR LED strip):
        // its colours as chips, the current one ringed; tap = that colour.
        // Laid out by hand in rows (Slint has no wrapping layout).
        if item.palette.length > 0: Rectangle {
            property <length> chip: 40px;
            property <length> gap: Theme.space-s;
            property <int> per-row: max(1, floor((self.width + gap) / (chip + gap)));
            height: ceil(item.palette.length / per-row) * (chip + gap) - gap;
            for c[i] in item.palette: Rectangle {
                x: (i - floor(i / per-row) * per-row) * (chip + gap);
                y: floor(i / per-row) * (chip + gap);
                width: chip;
                height: chip;
                border-radius: chip / 2;
                background: c.color;
                border-width: c.hex == item.color-text ? 3px : 1px;
                border-color: c.hex == item.color-text ? Theme.text : Theme.outline;
                TouchArea {
                    clicked => {
                        root.set-color(item.id, c.hex);
                    }
                }
            }
        }
        if item.has-color && item.palette.length == 0: Text {
            text: "Color " + item.color-text;
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }

        // A TV (issue #40): volume, mute, and its inputs. Like the dimmer,
        // only usable while it's on.
        if item.has-media: HorizontalLayout {
            spacing: Theme.space-l;
            volume := LevelBar {
                horizontal-stretch: 1;
                level: item.volume;
                enabled: item.on;
                set(level) => {
                    set-media(item.id, level, item.muted, item.input);
                }
            }
            Text {
                text: volume.shown;
                color: item.on ? Theme.text : Theme.text-muted;
                font-size: Theme.font-body;
                vertical-alignment: center;
                min-width: 32px;
                horizontal-alignment: right;
            }
            ActionButton {
                text: item.muted ? "Unmute" : "Mute";
                enabled: item.on;
                clicked => {
                    set-media(item.id, item.volume, !item.muted, item.input);
                }
            }
        }
        if item.has-media && item.inputs.length > 0: HorizontalLayout {
            spacing: Theme.space-xs;
            for input in item.inputs: Choice {
                text: input.label;
                selected: input.id == item.input;
                clicked => {
                    if (item.on) {
                        set-media(item.id, item.volume, item.muted, input.id);
                    }
                }
            }
        }

        // What's on screen, and the Remote page (issue #44).
        // An IR light (issue #85): brightness one step at a time, here
        // instead (the real level isn't known, so no bar).
        if item.has-remote || (item.has-media && item.now-playing != ""): HorizontalLayout {
            spacing: Theme.space-l;
            if item.brightness-up != "": Text {
                text: "Brightness";
                color: Theme.text-muted;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
            if item.brightness-up != "": ActionButton {
                text: "\u{2212}";
                clicked => {
                    root.press(item.id, item.brightness-down);
                }
            }
            if item.brightness-up != "": ActionButton {
                text: "+";
                clicked => {
                    root.press(item.id, item.brightness-up);
                }
            }
            Text {
                text: item.on ? item.now-playing : "";
                color: Theme.text-muted;
                font-size: Theme.font-body;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if item.has-remote: ActionButton {
                text: "Remote";
                // A TV's remote does nothing while the TV is off; a device
                // without an on/off state the hub knows (an IR blaster's,
                // issue #42) can always be used -- also an IR light, whose
                // on/off is only assumed (issue #85).
                enabled: item.on || !item.has-switch || item.remote-learns;
                clicked => {
                    root.open-remote(item.id);
                }
            }
        }

        if item.sensor-text != "": Text {
            text: item.sensor-text;
            color: Theme.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        // ---- Issue #77 ----

        // What it draws: the number people look at first.
        if item.energy-text != "": Text {
            text: item.energy-text;
            color: Theme.text;
            font-size: Theme.font-body;
            overflow: elide;
        }

        // A vacuum: what it does (or what's wrong), and its buttons: Start
        // -- Pause while it cleans --, Home, Find.
        // (On the controls page the tile above already says it -- unless
        // something's wrong.)
        if item.has-vacuum && (!root.in-sheet || item.vacuum-state == "error"): Text {
            text: item.vacuum-text;
            color: item.vacuum-state == "error" ? Theme.error : Theme.text-muted;
            font-size: Theme.font-caption;
            wrap: word-wrap;
        }
        if item.has-vacuum: HorizontalLayout {
            spacing: Theme.space-xs;
            ActionButton {
                text: item.vacuum-state == "cleaning" ? "Pause" : "Start";
                primary: item.vacuum-state != "cleaning";
                horizontal-stretch: 1;
                clicked => {
                    root.vacuum-action(item.id, item.vacuum-state == "cleaning" ? "pause" : "start", "");
                }
            }
            ActionButton {
                text: "Home";
                horizontal-stretch: 1;
                clicked => {
                    root.vacuum-action(item.id, "dock", "");
                }
            }
            ActionButton {
                text: "Find";
                horizontal-stretch: 1;
                clicked => {
                    root.vacuum-action(item.id, "locate", "");
                }
            }
        }
        if item.has-vacuum && item.vacuum-run-text != "": Text {
            text: item.vacuum-run-text;
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }
        // Suction, water, mop route: one row of choices each.
        if item.has-vacuum && item.vacuum-fans.length > 0: Text {
            text: "Suction";
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }
        if item.has-vacuum && item.vacuum-fans.length > 0: HorizontalLayout {
            spacing: Theme.space-xs;
            for m in item.vacuum-fans: Choice {
                text: m.label;
                selected: m.value == item.vacuum-fan;
                clicked => {
                    root.vacuum-action(item.id, "set_fan", m.value);
                }
            }
        }
        if item.has-vacuum && item.vacuum-waters.length > 0: Text {
            text: "Mop water";
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }
        if item.has-vacuum && item.vacuum-waters.length > 0: HorizontalLayout {
            spacing: Theme.space-xs;
            for m in item.vacuum-waters: Choice {
                text: m.label;
                selected: m.value == item.vacuum-water;
                clicked => {
                    root.vacuum-action(item.id, "set_water", m.value);
                }
            }
        }
        if item.has-vacuum && item.vacuum-mops.length > 0: Text {
            text: "Mop route";
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }
        if item.has-vacuum && item.vacuum-mops.length > 0: HorizontalLayout {
            spacing: Theme.space-xs;
            for m in item.vacuum-mops: Choice {
                text: m.label;
                selected: m.value == item.vacuum-mop;
                clicked => {
                    root.vacuum-action(item.id, "set_mop", m.value);
                }
            }
        }
        // Rooms: tap one to clean just it. None yet: how to get them.
        if item.has-vacuum: Text {
            text: item.vacuum-rooms.length > 0 ? "Clean a room"
                : "To clean single rooms: divide the map into rooms in the vendor's app (then Pair again here, for their names). Until then it cleans everything.";
            color: Theme.text-muted;
            font-size: Theme.font-caption;
            wrap: word-wrap;
        }
        if item.has-vacuum && item.vacuum-rooms.length > 0: VerticalLayout {
            spacing: Theme.space-xs;
            for r in item.vacuum-rooms: Choice {
                text: r.name;
                selected: false;
                clicked => {
                    root.vacuum-action(item.id, "clean_rooms", r.id);
                }
            }
        }
        if item.has-vacuum && item.vacuum-parts.length > 0: Text {
            text: "Parts";
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }
        if item.has-vacuum: VerticalLayout {
            spacing: Theme.space-xs;
            for p in item.vacuum-parts: PartRow {
                part: p;
                reset => {
                    root.vacuum-action(item.id, "reset_part", p.id);
                }
            }
        }
        if item.has-vacuum && (item.vacuum-totals-text != "" || item.vacuum-quiet-text != ""): Text {
            text: item.vacuum-totals-text + (item.vacuum-totals-text != "" && item.vacuum-quiet-text != "" ? "\n" : "") + item.vacuum-quiet-text;
            color: Theme.text-muted;
            font-size: Theme.font-caption;
            wrap: word-wrap;
        }

        // A camera that moves: a cross of arrows (one step per tap), then
        // its saved positions.
        if item.has-camera && item.camera-ptz: HorizontalLayout {
            alignment: center;
            spacing: Theme.space-xs;
            VerticalLayout {
                alignment: center;
                ActionButton {
                    text: "\u{25C0}";
                    clicked => {
                        root.camera-move(item.id, -0.5, 0);
                    }
                }
            }
            VerticalLayout {
                spacing: Theme.space-xs;
                ActionButton {
                    text: "\u{25B2}";
                    clicked => {
                        root.camera-move(item.id, 0, 0.5);
                    }
                }
                ActionButton {
                    text: "\u{25BC}";
                    clicked => {
                        root.camera-move(item.id, 0, -0.5);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                ActionButton {
                    text: "\u{25B6}";
                    clicked => {
                        root.camera-move(item.id, 0.5, 0);
                    }
                }
            }
        }
        if item.has-camera && item.camera-presets.length > 0: HorizontalLayout {
            spacing: Theme.space-xs;
            for p in item.camera-presets: Choice {
                text: p.label;
                selected: false;
                clicked => {
                    root.camera-preset(item.id, p.value);
                }
            }
        }

        // The device's own settings: a toggle each, or a row of choices.
        for o in item.options: VerticalLayout {
            spacing: Theme.space-xs;
            HorizontalLayout {
                spacing: Theme.space-m;
                Text {
                    text: o.name;
                    color: o.choices.length > 0 ? Theme.text-muted : Theme.text;
                    font-size: o.choices.length > 0 ? Theme.font-caption : Theme.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                if o.choices.length == 0: Toggle {
                    on: o.on;
                    toggled(on) => {
                        root.set-option(item.id, o.id, on);
                    }
                }
            }
            if o.choices.length > 0: HorizontalLayout {
                spacing: Theme.space-xs;
                for c in o.choices: Choice {
                    text: c.label;
                    selected: c.value == o.value;
                    clicked => {
                        root.set-option-value(item.id, o.id, c.value);
                    }
                }
            }
        }

        // A cover: where it is, the three buttons, and -- for one that can
        // stop anywhere -- a position bar (the dimmer's, so dragging works
        // the same).
        if item.has-cover: Text {
            text: item.cover-moving != "" ? item.cover-moving + "\u{2026}"
                : item.cover-position < 0 ? "Position not known"
                : item.cover-position == 0 ? "Closed"
                : item.cover-position == 100 ? "Open"
                : item.cover-position + "% open";
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }
        if item.has-cover: HorizontalLayout {
            spacing: Theme.space-xs;
            ActionButton {
                text: "Open";
                horizontal-stretch: 1;
                clicked => {
                    root.cover-action(item.id, "open");
                }
            }
            ActionButton {
                text: "Stop";
                horizontal-stretch: 1;
                clicked => {
                    root.cover-action(item.id, "stop");
                }
            }
            ActionButton {
                text: "Close";
                horizontal-stretch: 1;
                clicked => {
                    root.cover-action(item.id, "close");
                }
            }
        }
        if item.has-cover && item.cover-can-position: HorizontalLayout {
            spacing: Theme.space-l;
            position := LevelBar {
                horizontal-stretch: 1;
                level: max(0, item.cover-position);
                set(level) => {
                    root.set-cover-position(item.id, level);
                }
            }
            Text {
                text: position.shown + "%";
                color: Theme.text;
                font-size: Theme.font-body;
                vertical-alignment: center;
                min-width: 48px;
                horizontal-alignment: right;
            }
        }

        // An air conditioner / thermostat: its modes, the target with
        // - / + (one step each, within the device's range), what the room
        // is now, and the fan speeds it offers.
        if item.has-climate: HorizontalLayout {
            spacing: Theme.space-xs;
            for mode in item.climate-modes: Choice {
                text: mode == "off" ? "Off" : mode == "heat" ? "Heat" : mode == "cool" ? "Cool"
                    : mode == "auto" ? "Auto" : mode == "dry" ? "Dry" : mode == "fan" ? "Fan" : mode;
                selected: mode == item.climate-mode;
                clicked => {
                    root.set-climate(item.id, mode, item.climate-target, item.climate-fan);
                }
            }
        }
        if item.has-climate: HorizontalLayout {
            spacing: Theme.space-m;
            ActionButton {
                text: "\u{2212}";
                enabled: item.climate-target - item.climate-step >= item.climate-min - 0.001;
                clicked => {
                    root.set-climate(item.id, item.climate-mode, item.climate-target - item.climate-step, item.climate-fan);
                }
            }
            Text {
                text: item.climate-target-text;
                color: item.climate-mode == "off" ? Theme.text-muted : Theme.text;
                font-size: Theme.font-subtitle;
                vertical-alignment: center;
                horizontal-alignment: center;
                min-width: 96px;
            }
            ActionButton {
                text: "+";
                enabled: item.climate-target + item.climate-step <= item.climate-max + 0.001;
                clicked => {
                    root.set-climate(item.id, item.climate-mode, item.climate-target + item.climate-step, item.climate-fan);
                }
            }
            Text {
                text: item.climate-current-text != "" ? "Now " + item.climate-current-text : "";
                color: Theme.text-muted;
                font-size: Theme.font-body;
                vertical-alignment: center;
                horizontal-alignment: right;
                horizontal-stretch: 1;
            }
        }
        if item.has-climate && item.climate-fans.length > 0: HorizontalLayout {
            spacing: Theme.space-xs;
            Text {
                text: "Fan";
                color: Theme.text-muted;
                font-size: Theme.font-caption;
                vertical-alignment: center;
            }
            for fan in item.climate-fans: Choice {
                text: fan == "auto" ? "Auto" : fan == "quiet" ? "Quiet" : fan == "low" ? "Low"
                    : fan == "medium" ? "Medium" : fan == "high" ? "High" : fan == "turbo" ? "Turbo" : fan;
                selected: fan == item.climate-fan;
                clicked => {
                    root.set-climate(item.id, item.climate-mode, item.climate-target, fan);
                }
            }
        }

        // A lock: its state and Lock / Unlock. Unlocking asks first, right
        // on the card -- backend_daemon refuses an unlock that wasn't
        // confirmed (the unlock rule, issue #77).
        if item.has-lock && !asking-unlock: HorizontalLayout {
            spacing: Theme.space-m;
            Text {
                text: item.lock-state == "locked" ? "Locked" : item.lock-state == "unlocked" ? "Unlocked"
                    : item.lock-state == "jammed" ? "Jammed: check the door" : "State not known";
                color: item.lock-state == "jammed" ? Theme.error : Theme.text;
                font-size: Theme.font-body;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if item.lock-state != "locked": ActionButton {
                text: "Lock";
                clicked => {
                    root.set-lock(item.id, true);
                }
            }
            if item.lock-state != "unlocked": ActionButton {
                text: "Unlock";
                clicked => {
                    asking-unlock = true;
                }
            }
        }
        if item.has-lock && asking-unlock: HorizontalLayout {
            spacing: Theme.space-m;
            Text {
                text: "Unlock " + item.name + "?";
                color: Theme.text;
                font-size: Theme.font-body;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            ActionButton {
                text: "Cancel";
                clicked => {
                    asking-unlock = false;
                }
            }
            ActionButton {
                text: "Unlock";
                destructive: true;
                clicked => {
                    asking-unlock = false;
                    root.set-lock(item.id, false);
                }
            }
        }
    }

    // Not answered within 10 s: the question goes away by itself, so a
    // card left like this can't be unlocked by a later stray tap.
    Timer {
        interval: 10s;
        running: asking-unlock;
        triggered => {
            asking-unlock = false;
        }
    }
}
