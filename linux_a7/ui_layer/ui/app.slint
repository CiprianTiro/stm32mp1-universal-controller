// app.slint -- the actual UI layout and behavior, in Slint's own markup
// language (a declarative, CSS/QML-ish syntax -- not Rust). This file gets
// compiled into generated Rust code by build.rs; nothing in here runs
// directly, it just describes *what the UI looks like and does*, while
// main.rs decides *when* things like button clicks actually get acted on.

// Slint's own built-in widget library. `Palette` holds the colors its
// widgets (buttons, lists) use; it's switched to dark below.
import { Palette } from "std-widgets.slint";

// Embeds this specific font file into the compiled binary (combined with
// build.rs's `EmbedForSoftwareRenderer` config) rather than relying on
// system font discovery -- required, not just a preference: this app runs
// under Slint's software renderer with no compositor/desktop environment
// around it, and this board's minimal rootfs has no fontconfig
// configuration or font cache for system discovery to find anything with
// anyway. See fonts/DejaVuSans-LICENSE for its (permissive) license.
import "../fonts/DejaVuSans.ttf";

// The colors (shared with the boot image, see theme.slint) and the network
// screens (issue #61).
import { Theme, Splash, Glyphs } from "theme.slint";
import { HeaderButton } from "common.slint";
import { DeviceItem, MediaInputItem, ColorChip, DeviceRow } from "devices.slint";
import { TileItem, TileRow, FilterChip, TileGrid, FilterBar } from "tiles.slint";
import { Icon } from "icons.slint";
import { IconButton, NavBar, SceneChip, BigLevel } from "home.slint";
import { TemplateItem, FoundItem, FieldItem, ChoiceItem, VariantItem, AddDevicePage, WizardPage, DevicePage } from "wizard.slint";
import { RemoteItem, RemotePage } from "remote.slint";
import { IrRemotePage, IrKeyItem, IrRow } from "ir_remote.slint";
import { ClientItem, SettingsPage, ClientsPage, PairingPage } from "settings.slint";
import { NetStatus, WifiNetwork, NetIndicator, NetworkPage, PasswordPage, CountryPage } from "network.slint";
import { AccentItem, ZoneItem, AppearancePage, TimeZonePage } from "appearance.slint";
import { SceneItem, PickItem, ScenesPage, CaptureScenePage } from "scenes.slint";
import { AutomationItem, LogItem, AutomationsPage, LogPage, NewAutomationPage, LocationPage } from "automations.slint";

// Re-exported so main.rs can use these types (the Rust side only sees what
// the main file exports).
export { NetStatus, WifiNetwork, DeviceItem, MediaInputItem, ColorChip, TileItem, TileRow, FilterChip, ClientItem, AccentItem, ZoneItem }
export { TemplateItem, FoundItem, FieldItem, ChoiceItem, VariantItem, RemoteItem, IrKeyItem, IrRow }
export { SceneItem, PickItem, AutomationItem, LogItem }
// The design tokens (issue #39): main.rs's theme.rs sets them.
export { Theme }

// Shown from the UI's start until backend_daemon answers for the first time
// (issue #59). The background picture (icon + name) is the very same file
// the boot image is made from; this component only adds what moves: the
// three loading dots and the status text below them. Their positions are
// the constants from make_welcome.py (dots centred at y=560, 28 px apart,
// radius 7; text centred at y=600) -- if the design changes there, change
// them here too. Its colors are the fixed `Splash` ones (issue #39), not
// the chosen theme's: it has to match the boot image exactly.
component WelcomeScreen inherits Rectangle {
    // Set after 30 s without the backend: the text changes, so a hub whose
    // backend never comes up doesn't look like it's simply still booting.
    in property <bool> slow;

    // Which dot is lit: 0, 1, 2, 0, ...
    property <int> phase: 0;

    background: Splash.background;

    Image {
        source: @image-url("images/welcome.png");
        width: parent.width;
        height: parent.height;
    }

    // A Timer only changes `phase` 2.5 times a second, and only the dots'
    // few pixels are then redrawn -- unlike an endlessly running animation,
    // which would redraw at 60 fps and eat CPU while the rest of the system
    // is still booting.
    Timer {
        interval: 400ms;
        triggered => {
            phase = Math.mod(phase + 1, 3);
        }
    }

    // `for i in 3`: three copies of this rectangle, i = 0, 1, 2. A
    // rectangle with a border radius of half its size is a circle.
    for i in 3: Rectangle {
        x: parent.width / 2 + (i - 1) * 28px - 7px;
        y: 560px - 7px;
        width: 14px;
        height: 14px;
        border-radius: self.height / 2;
        background: i == phase ? Splash.accent : Splash.dot-off;
    }

    Text {
        // `\u{2026}` is the single "..." character, as in the boot image.
        text: slow ? "Still starting\u{2026} (hub service not answering)" : "Starting\u{2026}";
        color: Splash.muted;
        // 20 px as in make_welcome.py, fixed like the colors (not a token).
        font-size: 20px;
        width: parent.width;
        horizontal-alignment: center;
        // Centred on y=600, whatever the text's height.
        y: 600px - self.height / 2;
    }
}

// "component" is Slint's word for a reusable UI definition, similar to a
// React/Flutter/etc. "widget". `AppWindow` is the name main.rs's generated
// code (via `slint::include_modules!()`) will know this as.
export component AppWindow inherits Window {
    // The devices (issue #34), kept up to date by main.rs from
    // backend_daemon's events. Since issue #95 as tiles (tiles.slint):
    // rows of `tile-columns` tiles, a room's heading before its tiles,
    // only the ones the filter bar's chip `device-filter` selects. "in
    // property": Rust writes it, this file only reads it.
    in property <[TileRow]> tile-rows;
    in property <[FilterChip]> filter-chips;
    in-out property <string> device-filter: "all";
    // Tiles side by side: 2 on the touchscreen, 3 at 800x600, 4 wider.
    out property <int> tile-columns: root.width < 600px ? 2 : root.width < 1000px ? 3 : 4;
    // The device whose controls page (page 20) is open: its full card
    // (devices.slint's DeviceRow), and whether it's a favourite.
    in property <DeviceItem> controls-item;
    // Where a device's Remote and Details pages go back to: the controls
    // page if they were opened from it, else the Devices page.
    in-out property <int> device-back: 0;
    in property <bool> controls-favourite;
    // Its tile (tiles.rs): the icon, the state line, the tint.
    in property <TileItem> controls-tile;
    // The home screen's clock (issue #95): "22:31" and "Good evening -
    // Friday 3 October", set by main.rs in the hub's time zone.
    in property <string> clock-time;
    in property <string> clock-date;

    // The mouse pointer (issue #38), drawn by this file at the bottom:
    // Slint's software renderer doesn't draw one by itself. main.rs follows
    // the mouse and sets these; hidden until a mouse moves, and again as
    // soon as the touchscreen is touched.
    in property <length> pointer-x;
    in property <length> pointer-y;
    in property <bool> pointer-visible: false;
    // A refused command's reason (e.g. "no answer from the M4"), shown
    // briefly under the list; main.rs clears it again. `device-message-ok`:
    // good news instead ("Kitchen strip added"), shown in green.
    in property <string> device-message;
    in property <bool> device-message-ok: false;

    // Whether we're connected to backend_daemon right now -- lets the UI
    // honestly say so instead of silently showing a stale LED state as if
    // it were current.
    in-out property <bool> connected: false;

    // Whether we've EVER been connected since the UI started (issue #59).
    // Until then the hub is still starting, and the welcome screen is shown;
    // losing the connection later is a different situation (see the status
    // text below). Set by main.rs on the first connection, never unset.
    in-out property <bool> ever-connected: false;

    // After 30 s of welcome screen without a connection (see the Timer
    // below).
    property <bool> starting-slow: false;

    // ---- Network (issue #61) ----------------------------------------
    // Which screen is shown: 0 = main, 1 = network, 2 = WiFi password,
    // 3 = WiFi country, 4 = settings, 5 = paired devices, 6 = pairing,
    // 7 = appearance, 8 = time zone (issue #39),
    // 9 = add a device, 10 = the wizard's step, 11 = a device's details
    // (issue #40), 12 = a TV's remote (issue #44), 13 = an IR device's
    // remote (issue #42).
    in-out property <int> page: 0;
    // Where the network page's Back goes (main screen or settings).
    property <int> network-back: 0;
    // Filled in by main.rs from backend_daemon's answers.
    in property <NetStatus> net;
    in property <[WifiNetwork]> networks;
    in-out property <bool> scanning: false;
    // A WiFi connect is in progress.
    in-out property <bool> busy: false;
    // The network page's message line (result of the last action).
    in-out property <string> net-message;
    in-out property <bool> net-message-is-error;
    // The password page: which network, what's typed, and an error from
    // the last attempt.
    in-out property <string> join-ssid;
    in-out property <string> password;
    in-out property <string> join-message;
    // The country page.
    in-out property <string> country-code;
    in-out property <string> country-message;

    // ---- Paired devices and pairing (issue #35) ----------------------
    in property <[ClientItem]> clients;

    // ---- Scenes (issue #47, scenes.slint) -------------------------------
    // All of them (the Scenes page), and the first few for the Devices
    // page's quick buttons (main.rs picks how many fit).
    in property <[SceneItem]> scenes;
    in property <string> scenes-message;
    in property <bool> scenes-message-ok: true;
    // The scene being run right now ("" = none).
    in property <string> scene-running;
    // "Save current state": the devices to pick from, the name typed.
    in property <[PickItem]> pick-devices;
    in property <int> pick-count;
    in-out property <string> scene-name;
    in property <string> capture-message;
    in property <bool> capture-busy;
    callback run-scene(string);
    callback delete-scene(string);
    callback open-scenes();
    callback open-capture();
    callback toggle-pick(int);
    callback capture-scene(string);

    // ---- Automations (issue #47, automations.slint) ---------------------
    in property <[AutomationItem]> automations;
    in property <string> automations-message;
    in property <bool> automations-message-ok: true;
    in property <string> automation-running;
    in property <[LogItem]> log-entries;
    // The editor: devices that switch on/off, whether the hub knows where
    // it is, the name typed, how saving went.
    in property <[SceneItem]> switch-devices;
    // The scenes to choose from (its own copy: a new one each time the
    // editor opens, which also makes it start over).
    in property <[SceneItem]> editor-scenes;
    in property <bool> has-location;
    in-out property <string> automation-name;
    in property <string> automation-message;
    in property <bool> automation-busy;
    // The location page: what's typed, what's set ("" = not set).
    in-out property <string> location-text;
    in property <string> location-current;
    in property <string> location-message;
    callback open-automations();
    callback set-automation-enabled(string, bool);
    callback run-automation(string);
    callback delete-automation(string);
    callback open-log();
    callback new-automation();
    pure callback suggest-automation-name(int, int, int, int, string, string) -> string;
    // name, when, hour, minute, offset, days, device id, scene id
    callback save-automation(string, int, int, int, int, int, string, string);
    callback open-location(int);
    callback save-location(string);
    // Where the location page goes back to (Settings or the editor).
    in-out property <int> location-back: 4;
    in-out property <string> clients-message;
    // The pairing screen, filled in by main.rs (see PairingPage).
    in property <string> pairing-state;
    in property <string> pairing-code;
    in property <int> pairing-seconds;
    in property <string> pairing-client;
    in property <image> pairing-qr;
    in property <string> pairing-fingerprint;
    in property <string> pairing-address;
    // The setup hotspot (issue #36).
    in property <image> hotspot-qr;

    // ---- Hub settings (issue #39) --------------------------------------
    // The hub's settings as backend_daemon last reported them (main.rs).
    in property <string> setting-mode;
    in property <string> setting-accent;
    in property <string> setting-density;
    in property <string> setting-time-zone;
    // The chosen accent's display name, e.g. "Sky".
    in property <string> setting-accent-name;
    // The accent swatches, in the current mode's shades.
    in property <[AccentItem]> accents;
    // The current time in the hub's time zone, e.g. "14:05".
    in property <string> local-time;
    // The time zone page: regions first, then the places in one.
    in property <[ZoneItem]> zone-items;
    in property <string> zone-title;
    in property <string> zone-hint;
    callback set-mode(string);
    callback set-accent(string);
    callback set-density(string);
    callback open-time-zone();
    // A row tapped: a region (its places are listed next) or a place (the
    // hub's new time zone) -- main.rs tells them apart.
    callback pick-zone(ZoneItem);
    callback start-hotspot();
    callback stop-hotspot();
    callback open-clients();
    callback start-pairing();
    callback cancel-pairing();
    callback revoke-client(string);

    // Requests to main.rs, which forwards them to backend_daemon.
    callback wifi-scan();
    callback wifi-connect(string, string);
    callback wifi-forget();
    callback set-country(string);
    // Remove the last character of the given text (Slint's language has
    // no string slicing; done in Rust).
    pure callback drop-last(string) -> string;
    // The same text with every character replaced by a dot, for showing a
    // password (again: no string functions for this in Slint). `pure`: it
    // only computes, so Slint may call it whenever `password` changes.
    pure callback mask(string) -> string;

    // "callback" declares an event this component can fire that Rust
    // code reacts to -- see main.rs's `ui.on_set_switch(...)`. This file
    // only reports what was tapped; turning it into a command for
    // backend_daemon is Rust's job.
    callback set-switch(string, bool);
    callback set-level(string, int);
    // A TV's volume, mute and input (issue #40).
    callback set-media(string, int, bool, string);
    // Issue #77: a cover's open / close / stop and position, a climate
    // device's mode / target / fan, locking (true) or a CONFIRMED unlock.
    callback cover-action(string, string);
    callback set-cover-position(string, int);
    callback set-climate(string, string, float, string);
    callback set-lock(string, bool);
    // Issue #95: a filter chip tapped, a tile's controls opened, "Turn
    // all off" (the lights on), a device starred or not.
    callback pick-filter(string);
    callback open-controls(string);
    callback all-off();
    callback set-favourite(string, bool);
    // Issue #85: an IR light's colour chip, and its brightness -/+ (a
    // press of that device's remote button).
    callback set-color(string, string);
    callback device-press(string, string);

    // ---- Adding and setting up devices (issue #40, wizard.slint) -------
    // The "Add a device" page.
    in property <[TemplateItem]> templates;
    in property <[FoundItem]> found;
    in property <string> add-message;
    callback open-add-device();
    callback add-found(string, string);
    callback pick-template(string);
    callback search-devices();
    // The wizard's current step (see WizardPage), filled in by main.rs.
    in property <string> wizard-title;
    in property <string> wizard-step;
    in property <int> wizard-number;
    in property <string> wizard-text;
    in property <[string]> wizard-hints;
    in property <int> wizard-seconds;
    in property <[FoundItem]> wizard-found;
    in property <[FieldItem]> wizard-fields;
    in property <[VariantItem]> wizard-variants;
    in property <int> wizard-editing: -1;
    in-out property <string> wizard-edit-text;
    // The field being typed into is a secret: shown as dots.
    in property <bool> wizard-edit-secret;
    // A secret field shown in plain text (the wizard's Show / Hide).
    in-out property <bool> wizard-reveal: false;
    in property <string> wizard-error;
    in property <string> wizard-detail;
    in property <bool> wizard-busy;
    in property <string> wizard-primary: "Next";
    callback wizard-back();
    callback wizard-next();
    callback wizard-retry();
    callback wizard-pick-found(string);
    callback wizard-search();
    callback wizard-edit(int);
    callback wizard-pick(int, string);
    callback wizard-edit-done();
    callback wizard-switch-variant(string);
    // A device's details page.
    in property <string> dev-id;
    in property <string> dev-name;
    in property <string> dev-room;
    in property <string> dev-type;
    in property <string> dev-status;
    in property <bool> dev-can-reauth;
    in property <bool> dev-can-reconfigure;
    in property <bool> dev-can-remove;
    in property <bool> dev-has-remote;
    in property <bool> dev-remote-learns;
    in property <string> dev-message;
    // A TV's remote (issue #44, remote.slint).
    in property <string> remote-id;
    in property <string> remote-name;
    in property <string> remote-playing;
    in property <bool> remote-keyboard;
    in-out property <int> remote-view: 0;
    in property <[RemoteItem]> remote-items;
    in property <bool> remote-loading;
    in-out property <string> remote-text;
    in property <string> remote-message;
    in property <int> remote-total;
    in-out property <string> remote-query;
    callback remote-search(string);
    callback remote-more();
    callback open-remote(string);
    callback remote-press(string);
    callback remote-open-apps();
    callback remote-open-channels();
    callback remote-pick(string);
    callback remote-send-text();
    // An IR blaster device's remote (issue #42, ir_remote.slint): the
    // taught buttons. Taps go out through the same remote-id.
    in property <[string]> ir-buttons;
    in property <[IrRow]> ir-layout;
    in property <[string]> ir-others;
    in property <[IrKeyItem]> ir-labelled;
    in property <string> ir-status;
    in property <string> ir-message;
    in property <bool> ir-message-ok;
    in-out property <int> ir-view: 0;
    in-out property <string> ir-text;
    in-out property <string> ir-selected;
    callback ir-press(string);
    callback ir-learn(string);
    callback ir-forget(string);
    callback ir-rename(string, string);
    // Issue #85: used as a light, and its strip's colour order.
    in property <bool> ir-light;
    in property <string> ir-order;
    callback ir-set-light(bool, string);
    // Its code finder for a lost remote (issue #82, ir_finder.rs).
    in property <[RemoteItem]> ir-items;
    in property <bool> ir-loading;
    in property <string> ir-question;
    in property <string> ir-detail;
    callback ir-find();
    callback ir-pick(string, string);
    callback ir-answer(bool);
    callback ir-resend();
    callback open-device(string);
    callback device-reauth(string);
    callback device-reconfigure(string);
    callback device-remove(string);

    background: Theme.background;

    // std-widgets (the ListView's scrollbar) have their own palette; it
    // follows the theme's mode (issue #39). `init` runs once, when the
    // window is created; `changed` whenever main.rs switches the mode.
    property <bool> dark-mode: Theme.dark;
    init => {
        Palette.color-scheme = dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    // Runs once, 30 s after start, if the backend still hasn't answered.
    Timer {
        interval: 30s;
        running: !ever-connected && !starting-slow;
        triggered => {
            starting-slow = true;
        }
    }

    // The normal screen: a top bar (title, network indicator), then every
    // device, drawn from its capabilities (devices.slint).
    // Issue #95: the bottom bar's height on the four main places (Home,
    // Scenes, Automations, Settings), 0 elsewhere.
    property <length> nav-height: (page == 0 || page == 4 || page == 14 || page == 16) && ever-connected ? 68px : 0px;

    if page == 0: VerticalLayout {
        y: 0;
        height: parent.height - nav-height;
        padding: Theme.space-s;
        padding-left: Theme.space-l;
        padding-right: Theme.space-l;
        spacing: Theme.space-s;

        // The clock, the greeting and the date (issue #95: the hub is a
        // wall panel), then add-a-device and the network.
        HorizontalLayout {
            spacing: Theme.space-s;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.clock-time;
                    color: Theme.text;
                    font-size: Theme.font-display;
                }
                Text {
                    text: root.clock-date;
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Theme.space-s;
                    // Add a device (issue #40).
                    IconButton {
                        icon: "add";
                        clicked => {
                            root.open-add-device();
                        }
                    }
                    NetIndicator {
                        net: root.net;
                        compact: true;
                        clicked => {
                            net-message = "";
                            network-back = 0;
                            page = 1;
                            wifi-scan();
                        }
                    }
                }
            }
        }

        // Scenes (issue #47): one tap runs one; all of them, scrolled
        // sideways when they don't fit.
        if scenes.length > 0: Flickable {
            height: 44px;
            content-width: max(self.width, scene-row.preferred-width);
            scene-row := HorizontalLayout {
                spacing: Theme.space-s;
                alignment: start;
                for scene in scenes: SceneChip {
                    text: scene.name;
                    running: scene-running == scene.id;
                    clicked => {
                        root.run-scene(scene.id);
                    }
                }
            }
        }

        // Lost the backend after having had it (issue #59): say so, and
        // keep showing the last known devices underneath.
        if !connected: Text {
            text: "Connection to the hub lost, reconnecting\u{2026}";
            color: Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        if device-message != "": Text {
            text: device-message;
            color: device-message-ok ? Theme.ok : Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        // Devices found on the network, not added yet (issue #40): one tap
        // to the "Add a device" page, where they're listed first.
        if found.length > 0: Rectangle {
            height: Theme.touch-height;
            border-radius: Theme.radius-medium;
            background: found-touch.pressed ? Theme.surface-pressed : Theme.surface;
            border-width: 1px;
            border-color: Theme.accent;
            Text {
                x: Theme.space-l;
                width: parent.width - 2 * Theme.space-l;
                text: (found.length == 1 ? "1 new device" : found.length + " new devices") + " found on your network. Add\u{2026}";
                color: Theme.accent;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
            found-touch := TouchArea {
                clicked => {
                    root.open-add-device();
                }
            }
        }

        // Issue #95: what to show -- summaries ("3 on", "18 W", "2
        // offline"), All, Favourites, the rooms -- then the tiles.
        FilterBar {
            chips: root.filter-chips;
            selected: root.device-filter;
            pick(id) => {
                root.pick-filter(id);
            }
        }
        // The lights that are on: all off with one tap.
        if device-filter == "lights": HeaderButton {
            text: "Turn all off";
            clicked => {
                root.all-off();
            }
        }
        TileGrid {
            vertical-stretch: 1;
            rows: root.tile-rows;
            columns: root.tile-columns;
            empty-text: root.filter-chips.length == 0 ? "No devices yet.\n\nTap + to add one." : "Nothing here right now.";
            toggle(id, on) => {
                root.set-switch(id, on);
            }
            open(id) => {
                root.open-controls(id);
            }
        }
    }

    // Issue #95: one device's controls -- its full card, as the Devices
    // page showed every device until then -- with a star and its details.
    if page == 20: VerticalLayout {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        padding: Theme.space-l;
        spacing: Theme.space-m;
        property <bool> lit: controls-tile.on && controls-tile.status == "";
        // Back, the star (Favourites), the details page.
        HorizontalLayout {
            spacing: Theme.space-s;
            IconButton {
                icon: "back";
                clicked => {
                    device-back = 0;
                    page = 0;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            IconButton {
                icon: root.controls-favourite ? "star" : "star-outline";
                tint: root.controls-favourite ? Theme.accent : Theme.text-muted;
                clicked => {
                    root.set-favourite(root.controls-item.id, !root.controls-favourite);
                }
            }
            IconButton {
                icon: "info";
                clicked => {
                    root.open-device(root.controls-item.id);
                }
            }
        }
        // The device: its icon glowing in its colour while on, its name and
        // state, and -- if it has one -- a big power button.
        Rectangle {
            height: 104px;
            border-radius: Theme.radius-medium * 2;
            background: lit ? controls-tile.tint.mix(Theme.surface, 0.22) : Theme.surface;
            animate background { duration: 180ms; }
            HorizontalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-l;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: self.height / 2;
                        background: lit ? controls-tile.tint : Theme.surface-pressed;
                        animate background { duration: 180ms; }
                        Icon {
                            width: 32px;
                            height: 32px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            kind: controls-tile.icon;
                            color: lit ? controls-tile.on-tint : Theme.text-muted;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: Theme.space-xxs;
                    Text {
                        text: controls-item.name;
                        color: Theme.text;
                        font-size: Theme.font-heading;
                        overflow: elide;
                    }
                    Text {
                        text: controls-tile.status != "" ? controls-tile.status : controls-tile.state;
                        color: controls-tile.status != "" ? Theme.error : Theme.text-muted;
                        font-size: Theme.font-body;
                        overflow: elide;
                    }
                    if controls-item.room != "": Text {
                        text: controls-item.room;
                        color: Theme.text-muted;
                        font-size: Theme.font-caption;
                        overflow: elide;
                    }
                }
                if controls-item.has-switch: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: self.height / 2;
                        background: power-touch.pressed ? Theme.surface-pressed
                            : controls-item.on ? controls-tile.tint : Theme.surface-pressed;
                        animate background { duration: 180ms; }
                        Icon {
                            width: 32px;
                            height: 32px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            kind: "power-button";
                            color: controls-item.on ? controls-tile.on-tint : Theme.text;
                        }
                        power-touch := TouchArea {
                            clicked => {
                                root.set-switch(controls-item.id, !controls-item.on);
                            }
                        }
                    }
                }
            }
        }
        if device-message != "": Text {
            text: device-message;
            color: device-message-ok ? Theme.ok : Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        // Brightness: a big slider in the light's colour.
        if controls-item.has-dimmer: BigLevel {
            level: controls-item.level;
            tint: controls-tile.tint;
            enabled: !controls-item.has-switch || controls-item.on;
            set(level) => {
                root.set-level(controls-item.id, level);
            }
        }
        // Everything else the old card had (colours, remote, media,
        // cover, climate, lock...), without its name, switch and level.
        if controls-item.has-color || controls-item.has-media || controls-item.has-remote || controls-item.has-cover
            || controls-item.has-climate || controls-item.has-lock || controls-item.sensor-text != ""
            || controls-item.energy-text != "" || controls-item.can-reauth: DeviceRow {
            // As tall as its content; the space below stays empty.
            vertical-stretch: 0;
            in-sheet: true;
            item: root.controls-item;
            set-switch(id, on) => {
                root.set-switch(id, on);
            }
            set-level(id, level) => {
                root.set-level(id, level);
            }
            set-media(id, volume, muted, input) => {
                root.set-media(id, volume, muted, input);
            }
            open(id) => {
                root.open-device(id);
            }
            reauth(id) => {
                root.device-reauth(id);
            }
            open-remote(id) => {
                root.open-remote(id);
            }
            cover-action(id, action) => {
                root.cover-action(id, action);
            }
            set-cover-position(id, position) => {
                root.set-cover-position(id, position);
            }
            set-climate(id, mode, target, fan) => {
                root.set-climate(id, mode, target, fan);
            }
            set-lock(id, locked) => {
                root.set-lock(id, locked);
            }
            set-color(id, hex) => {
                root.set-color(id, hex);
            }
            press(id, button) => {
                root.device-press(id, button);
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    if page == 13: IrRemotePage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        device-name: root.remote-name;
        buttons: root.ir-buttons;
        layout: root.ir-layout;
        others: root.ir-others;
        labelled: root.ir-labelled;
        status: root.ir-status;
        message: root.ir-message;
        message-ok: root.ir-message-ok;
        view <=> root.ir-view;
        text <=> root.ir-text;
        selected <=> root.ir-selected;
        items: root.ir-items;
        loading: root.ir-loading;
        question: root.ir-question;
        detail: root.ir-detail;
        back => {
            page = device-back;
        }
        press(button) => {
            root.ir-press(button);
        }
        find => {
            root.ir-find();
        }
        pick(id, label) => {
            root.ir-pick(id, label);
        }
        answer(yes) => {
            root.ir-answer(yes);
        }
        resend => {
            root.ir-resend();
        }
        learn(button) => {
            root.ir-learn(button);
        }
        forget(button) => {
            root.ir-forget(button);
        }
        rename(button, to) => {
            root.ir-rename(button, to);
        }
        light: root.ir-light;
        order: root.ir-order;
        set-light(on, order) => {
            root.ir-set-light(on, order);
        }
        backspace => {
            root.ir-text = drop-last(root.ir-text);
        }
    }

    if page == 12: RemotePage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        tv-name: root.remote-name;
        now-playing: root.remote-playing;
        keyboard: root.remote-keyboard;
        view <=> root.remote-view;
        items: root.remote-items;
        loading: root.remote-loading;
        text <=> root.remote-text;
        message: root.remote-message;
        total: root.remote-total;
        query <=> root.remote-query;
        search(q) => {
            root.remote-search(q);
        }
        more => {
            root.remote-more();
        }
        back => {
            page = device-back;
        }
        press(button) => {
            root.remote-press(button);
        }
        open-apps => {
            root.remote-open-apps();
        }
        open-channels => {
            root.remote-open-channels();
        }
        pick(id) => {
            root.remote-pick(id);
        }
        send-text => {
            root.remote-send-text();
        }
        backspace => {
            // The keyboard is either the TV text (view 3) or the search.
            if (root.remote-view == 2) {
                root.remote-query = drop-last(root.remote-query);
            } else {
                root.remote-text = drop-last(root.remote-text);
            }
        }
    }

    if page == 9: AddDevicePage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        found: root.found;
        templates: root.templates;
        message: root.add-message;
        back => {
            page = 0;
        }
        add-found(template, address) => {
            root.add-found(template, address);
        }
        pick-template(id) => {
            root.pick-template(id);
        }
        search => {
            root.search-devices();
        }
    }

    if page == 10: WizardPage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        title: root.wizard-title;
        step: root.wizard-step;
        number: root.wizard-number;
        text: root.wizard-text;
        hints: root.wizard-hints;
        seconds: root.wizard-seconds;
        found: root.wizard-found;
        fields: root.wizard-fields;
        variants: root.wizard-variants;
        editing: root.wizard-editing;
        edit-text <=> root.wizard-edit-text;
        edit-shown: root.wizard-edit-secret && !root.wizard-reveal ? mask(root.wizard-edit-text) : root.wizard-edit-text;
        reveal <=> root.wizard-reveal;
        error: root.wizard-error;
        detail: root.wizard-detail;
        busy: root.wizard-busy;
        primary-text: root.wizard-primary;
        back => {
            root.wizard-back();
        }
        next => {
            root.wizard-next();
        }
        retry => {
            root.wizard-retry();
        }
        pick-found(address) => {
            root.wizard-pick-found(address);
        }
        search => {
            root.wizard-search();
        }
        edit(i) => {
            root.wizard-edit(i);
        }
        pick(i, value) => {
            root.wizard-pick(i, value);
        }
        edit-done => {
            root.wizard-edit-done();
        }
        backspace => {
            root.wizard-edit-text = drop-last(root.wizard-edit-text);
        }
        switch-variant(id) => {
            root.wizard-switch-variant(id);
        }
    }

    if page == 11: DevicePage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        name: root.dev-name;
        room: root.dev-room;
        type-name: root.dev-type;
        status: root.dev-status;
        can-reauth: root.dev-can-reauth;
        can-reconfigure: root.dev-can-reconfigure;
        can-remove: root.dev-can-remove;
        message: root.dev-message;
        has-remote: root.dev-has-remote;
        remote-learns: root.dev-remote-learns;
        back => {
            page = device-back;
        }
        open-remote => {
            root.open-remote(root.dev-id);
        }
        reauth => {
            root.device-reauth(root.dev-id);
        }
        reconfigure => {
            root.device-reconfigure(root.dev-id);
        }
        remove => {
            root.device-remove(root.dev-id);
        }
    }

    // Scenes (issue #47).
    if page == 14: ScenesPage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        y: 0;
        height: parent.height - nav-height;
        scenes: root.scenes;
        message: root.scenes-message;
        message-ok: root.scenes-message-ok;
        running: root.scene-running;
        back => {
            page = 0;
        }
        run(id) => {
            root.run-scene(id);
        }
        delete(id) => {
            root.delete-scene(id);
        }
        new-scene => {
            root.open-capture();
        }
    }
    if page == 15: CaptureScenePage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        devices: root.pick-devices;
        selected-count: root.pick-count;
        name <=> root.scene-name;
        message: root.capture-message;
        busy: root.capture-busy;
        back => {
            page = 14;
        }
        toggle(index) => {
            root.toggle-pick(index);
        }
        backspace => {
            root.scene-name = drop-last(root.scene-name);
        }
        save => {
            root.capture-scene(root.scene-name);
        }
    }

    // Automations (issue #47).
    if page == 16: AutomationsPage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        y: 0;
        height: parent.height - nav-height;
        automations: root.automations;
        message: root.automations-message;
        message-ok: root.automations-message-ok;
        running: root.automation-running;
        back => {
            page = 4;
        }
        set-enabled(id, on) => {
            root.set-automation-enabled(id, on);
        }
        run(id) => {
            root.run-automation(id);
        }
        delete(id) => {
            root.delete-automation(id);
        }
        open-log => {
            root.open-log();
        }
        new-automation => {
            root.new-automation();
        }
    }
    if page == 17: LogPage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        entries: root.log-entries;
        back => {
            page = 16;
        }
    }
    if page == 18: NewAutomationPage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        scenes: root.editor-scenes;
        switch-devices: root.switch-devices;
        has-location: root.has-location;
        message: root.automation-message;
        busy: root.automation-busy;
        name <=> root.automation-name;
        back => {
            page = 16;
        }
        backspace => {
            root.automation-name = drop-last(root.automation-name);
        }
        open-location => {
            root.open-location(18);
        }
        suggest(when, hour, minute, offset, device, scene) => {
            return root.suggest-automation-name(when, hour, minute, offset, device, scene);
        }
        save(when, hour, minute, offset, days, device, scene) => {
            root.save-automation(root.automation-name, when, hour, minute, offset, days, device, scene);
        }
    }
    if page == 19: LocationPage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        text <=> root.location-text;
        current: root.location-current;
        message: root.location-message;
        back => {
            page = root.location-back;
        }
        backspace => {
            root.location-text = drop-last(root.location-text);
        }
        save(text) => {
            root.save-location(text);
        }
    }

    if page == 4: SettingsPage {
        // Issue #38: centred, at most Theme.content-max-width wide.
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        y: 0;
        height: parent.height - nav-height;
        network-detail: root.net.uplink == "ethernet" ? "Connected by cable"
            : root.net.uplink == "wifi" ? ("WiFi " + root.net.wifi-ssid) : "Offline";
        client-count: root.clients.length;
        appearance-detail: (setting-mode == "auto" ? "Auto" : setting-mode == "light" ? "Light" : "Dark")
            + ", " + setting-accent-name + ", " + setting-density;
        time-zone-detail: setting-time-zone + ", " + local-time;
        scenes-detail: scenes.length == 0 ? "None yet" : scenes.length == 1 ? "1 scene" : scenes.length + " scenes";
        automations-detail: automations.length == 0 ? "None yet" : automations.length == 1 ? "1 automation" : automations.length + " automations";
        location-detail: location-current == "" ? "Not set (needed for sunrise and sunset)" : location-current;
        open-scenes => {
            root.open-scenes();
        }
        open-automations => {
            root.open-automations();
        }
        open-location => {
            root.open-location(4);
        }
        back => {
            page = 0;
        }
        open-appearance => {
            page = 7;
        }
        open-time-zone => {
            root.open-time-zone();
            page = 8;
        }
        open-network => {
            net-message = "";
            network-back = 4;
            page = 1;
            wifi-scan();
        }
        open-clients => {
            clients-message = "";
            page = 5;
            open-clients();
        }
    }

    if page == 5: ClientsPage {
        // Issue #38: centred, at most Theme.content-max-width wide.
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        clients: root.clients;
        message: root.clients-message;
        back => {
            page = 4;
        }
        pair-new => {
            page = 6;
            start-pairing();
        }
        revoke(id) => {
            revoke-client(id);
        }
    }

    if page == 6: PairingPage {
        // Issue #38: centred, at most Theme.content-max-width wide.
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        state: root.pairing-state;
        code: root.pairing-code;
        seconds-left: root.pairing-seconds;
        client-name: root.pairing-client;
        qr: root.pairing-qr;
        fingerprint-short: root.pairing-fingerprint;
        address: root.pairing-address;
        back => {
            // Leaving the screen ends a pairing still waiting: a code
            // shouldn't stay valid while nobody is looking at it.
            cancel-pairing();
            clients-message = "";
            page = 5;
            open-clients();
        }
        restart => {
            start-pairing();
        }
    }

    // Never visible (zero size, transparent): only here so the extra
    // characters in theme.slint's Glyphs are embedded in the build (see
    // there). Being part of the window keeps it from being optimized away.
    Text {
        width: 0;
        height: 0;
        opacity: 0;
        text: Glyphs.extra;
    }

    if page == 1: NetworkPage {
        // Issue #38: centred, at most Theme.content-max-width wide.
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        // `root.` everywhere: inside an element, a bare `net` would mean
        // the element's OWN property of that name (binding it to itself).
        net: root.net;
        networks: root.networks;
        scanning: root.scanning;
        message: root.net-message;
        message-is-error: root.net-message-is-error;
        hotspot-qr: root.hotspot-qr;
        start-hotspot => {
            root.start-hotspot();
        }
        stop-hotspot => {
            root.stop-hotspot();
        }
        back => {
            page = network-back;
        }
        scan => {
            wifi-scan();
        }
        pick(n) => {
            if (net.wifi-connected && n.ssid == net.wifi-ssid) {
                // Already on it: nothing to do.
                return;
            }
            join-ssid = n.ssid;
            password = "";
            join-message = "";
            net-message = "";
            if (n.secure) {
                page = 2;
            } else {
                // An open network needs no password.
                busy = true;
                wifi-connect(n.ssid, "");
            }
        }
        forget => {
            net-message = "";
            wifi-forget();
        }
        change-country => {
            country-code = "";
            country-message = "";
            page = 3;
        }
    }

    if page == 2: PasswordPage {
        // Issue #38: centred, at most Theme.content-max-width wide.
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        ssid: root.join-ssid;
        // Two-way: the keyboard types into the window's `password`.
        password <=> root.password;
        masked: mask(root.password);
        busy: root.busy;
        message: root.join-message;
        back => {
            password = "";
            page = 1;
        }
        backspace => {
            password = drop-last(password);
        }
        connect => {
            join-message = "";
            busy = true;
            wifi-connect(join-ssid, password);
        }
    }

    if page == 3: CountryPage {
        // Issue #38: centred, at most Theme.content-max-width wide.
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        current: root.net.wifi-country;
        code <=> root.country-code;
        message: root.country-message;
        back => {
            page = 1;
        }
        backspace => {
            country-code = drop-last(country-code);
        }
        save => {
            set-country(country-code);
        }
    }

    if page == 7: AppearancePage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        mode: root.setting-mode;
        accent: root.setting-accent;
        density: root.setting-density;
        accents: root.accents;
        accent-name: root.setting-accent-name;
        time-zone: root.setting-time-zone;
        back => {
            page = 4;
        }
        set-mode(m) => {
            root.set-mode(m);
        }
        set-accent(a) => {
            root.set-accent(a);
        }
        set-density(d) => {
            root.set-density(d);
        }
    }

    if page == 8: TimeZonePage {
        width: min(parent.width, Theme.content-max-width);
        x: (parent.width - self.width) / 2;
        height: parent.height;
        title: root.zone-title;
        hint: root.zone-hint;
        items: root.zone-items;
        // main.rs knows whether a list of places is showing: then Back
        // returns to the regions, otherwise to the settings.
        back => {
            if (zone-title == "Time zone") {
                page = 4;
            } else {
                root.open-time-zone();
            }
        }
        pick(item) => {
            root.pick-zone(item);
        }
    }

    // Issue #95: the bottom bar on the four main places.
    if nav-height > 0: NavBar {
        y: parent.height - self.height;
        width: parent.width;
        height: nav-height;
        current: page == 14 ? 1 : page == 16 ? 2 : page == 4 ? 3 : 0;
        go(place) => {
            if (place == 0) {
                device-back = 0;
                page = 0;
            } else if (place == 1) {
                root.open-scenes();
            } else if (place == 2) {
                root.open-automations();
            } else {
                page = 4;
            }
        }
    }

    // Drawn last = on top of everything above, covering the whole window.
    // `if`: the welcome screen only exists while the condition holds; once
    // the backend has answered, it's removed for good (along with its
    // timer).
    if !ever-connected: WelcomeScreen {
        width: parent.width;
        height: parent.height;
        slow: starting-slow;
    }

    // The mouse pointer: drawn after everything else, so it's on top of
    // it all -- even the welcome screen. An Image takes no clicks, so every
    // click still reaches whatever is underneath. The arrow's tip is its
    // top-left pixel, placed exactly at the pointer's position (the point
    // Slint clicks). pointer.png: tools/pointer/make_pointer.py.
    if pointer-visible: Image {
        x: pointer-x;
        y: pointer-y;
        source: @image-url("images/pointer.png");
    }
}
