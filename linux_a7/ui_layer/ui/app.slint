// app.slint -- the actual UI layout and behavior, in Slint's own markup
// language (a declarative, CSS/QML-ish syntax -- not Rust). This file gets
// compiled into generated Rust code by build.rs; nothing in here runs
// directly, it just describes *what the UI looks like and does*, while
// main.rs decides *when* things like button clicks actually get acted on.

// Slint's own built-in widget library. `Palette` holds the colors its
// widgets (buttons, lists) use; it's switched to dark below.
import { Palette } from "std-widgets.slint";

// Embeds this specific font file into the compiled binary (combined with
// build.rs's `EmbedForSoftwareRenderer` config) rather than relying on
// system font discovery -- required, not just a preference: this app runs
// under Slint's software renderer with no compositor/desktop environment
// around it, and this board's minimal rootfs has no fontconfig
// configuration or font cache for system discovery to find anything with
// anyway. See fonts/DejaVuSans-LICENSE for its (permissive) license.
import "../fonts/DejaVuSans.ttf";

// The colors (shared with the boot image, see theme.slint) and the network
// screens (issue #61).
import { Theme, Glyphs } from "theme.slint";
import { DeviceItem, DeviceList } from "devices.slint";
import { NetStatus, WifiNetwork, NetIndicator, NetworkPage, PasswordPage, CountryPage } from "network.slint";

// Re-exported so main.rs can use these types (the Rust side only sees what
// the main file exports).
export { NetStatus, WifiNetwork, DeviceItem }

// Shown from the UI's start until backend_daemon answers for the first time
// (issue #59). The background picture (icon + name) is the very same file
// the boot image is made from; this component only adds what moves: the
// three loading dots and the status text below them. Their positions are
// the constants from make_welcome.py (dots centred at y=560, 28 px apart,
// radius 7; text centred at y=600) -- if the design changes there, change
// them here too.
component WelcomeScreen inherits Rectangle {
    // Set after 30 s without the backend: the text changes, so a hub whose
    // backend never comes up doesn't look like it's simply still booting.
    in property <bool> slow;

    // Which dot is lit: 0, 1, 2, 0, ...
    property <int> phase: 0;

    background: Theme.background;

    Image {
        source: @image-url("images/welcome.png");
        width: parent.width;
        height: parent.height;
    }

    // A Timer only changes `phase` 2.5 times a second, and only the dots'
    // few pixels are then redrawn -- unlike an endlessly running animation,
    // which would redraw at 60 fps and eat CPU while the rest of the system
    // is still booting.
    Timer {
        interval: 400ms;
        triggered => {
            phase = Math.mod(phase + 1, 3);
        }
    }

    // `for i in 3`: three copies of this rectangle, i = 0, 1, 2. A
    // rectangle with a border radius of half its size is a circle.
    for i in 3: Rectangle {
        x: parent.width / 2 + (i - 1) * 28px - 7px;
        y: 560px - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: i == phase ? Theme.accent : Theme.dot-off;
    }

    Text {
        // `\u{2026}` is the single "..." character, as in the boot image.
        text: slow ? "Still starting\u{2026} (hub service not answering)" : "Starting\u{2026}";
        color: Theme.muted;
        font-size: 20px;
        width: parent.width;
        horizontal-alignment: center;
        // Centred on y=600, whatever the text's height.
        y: 600px - self.height / 2;
    }
}

// "component" is Slint's word for a reusable UI definition, similar to a
// React/Flutter/etc. "widget". `AppWindow` is the name main.rs's generated
// code (via `slint::include_modules!()`) will know this as.
export component AppWindow inherits Window {
    // The devices (issue #34), one DeviceItem per device, kept up to date
    // by main.rs from backend_daemon's events. "in property": Rust writes
    // it, this file only reads it.
    in property <[DeviceItem]> devices;
    // A refused command's reason (e.g. "no answer from the M4"), shown
    // briefly under the list; main.rs clears it again.
    in property <string> device-message;

    // Whether we're connected to backend_daemon right now -- lets the UI
    // honestly say so instead of silently showing a stale LED state as if
    // it were current.
    in-out property <bool> connected: false;

    // Whether we've EVER been connected since the UI started (issue #59).
    // Until then the hub is still starting, and the welcome screen is shown;
    // losing the connection later is a different situation (see the status
    // text below). Set by main.rs on the first connection, never unset.
    in-out property <bool> ever-connected: false;

    // After 30 s of welcome screen without a connection (see the Timer
    // below).
    property <bool> starting-slow: false;

    // ---- Network (issue #61) ----------------------------------------
    // Which screen is shown: 0 = main, 1 = network, 2 = WiFi password,
    // 3 = WiFi country.
    in-out property <int> page: 0;
    // Filled in by main.rs from backend_daemon's answers.
    in property <NetStatus> net;
    in property <[WifiNetwork]> networks;
    in-out property <bool> scanning: false;
    // A WiFi connect is in progress.
    in-out property <bool> busy: false;
    // The network page's message line (result of the last action).
    in-out property <string> net-message;
    in-out property <bool> net-message-is-error;
    // The password page: which network, what's typed, and an error from
    // the last attempt.
    in-out property <string> join-ssid;
    in-out property <string> password;
    in-out property <string> join-message;
    // The country page.
    in-out property <string> country-code;
    in-out property <string> country-message;

    // Requests to main.rs, which forwards them to backend_daemon.
    callback wifi-scan();
    callback wifi-connect(string, string);
    callback wifi-forget();
    callback set-country(string);
    // Remove the last character of the given text (Slint's language has
    // no string slicing; done in Rust).
    pure callback drop-last(string) -> string;
    // The same text with every character replaced by a dot, for showing a
    // password (again: no string functions for this in Slint). `pure`: it
    // only computes, so Slint may call it whenever `password` changes.
    pure callback mask(string) -> string;

    // "callback" declares an event this component can fire that Rust
    // code reacts to -- see main.rs's `ui.on_set_switch(...)`. This file
    // only reports what was tapped; turning it into a command for
    // backend_daemon is Rust's job.
    callback set-switch(string, bool);
    callback set-level(string, int);

    // The whole UI uses the dark look of the welcome screen, so switching
    // from it to the normal screen isn't a jump from dark to bright.
    // `init` runs once, when the window is created.
    background: Theme.background;
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Runs once, 30 s after start, if the backend still hasn't answered.
    Timer {
        interval: 30s;
        running: !ever-connected && !starting-slow;
        triggered => {
            starting-slow = true;
        }
    }

    // The normal screen: a top bar (title, network indicator), then every
    // device, drawn from its capabilities (devices.slint).
    if page == 0: VerticalLayout {
        padding: 8px;
        spacing: 8px;

        HorizontalLayout {
            height: Theme.touch-height;
            spacing: 8px;
            Text {
                text: "Devices";
                color: Theme.title;
                font-size: 24px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            NetIndicator {
                net: root.net;
                clicked => {
                    net-message = "";
                    page = 1;
                    wifi-scan();
                }
            }
        }

        // Lost the backend after having had it (issue #59): say so, and
        // keep showing the last known devices underneath.
        if !connected: Text {
            text: "Connection to the hub lost, reconnecting\u{2026}";
            color: Theme.error;
            font-size: 16px;
            wrap: word-wrap;
        }

        if device-message != "": Text {
            text: device-message;
            color: Theme.error;
            font-size: 16px;
            wrap: word-wrap;
        }

        DeviceList {
            vertical-stretch: 1;
            devices: root.devices;
            set-switch(id, on) => {
                root.set-switch(id, on);
            }
            set-level(id, level) => {
                root.set-level(id, level);
            }
        }
    }

    // Never visible (zero size, transparent): only here so the extra
    // characters in theme.slint's Glyphs are embedded in the build (see
    // there). Being part of the window keeps it from being optimized away.
    Text {
        width: 0;
        height: 0;
        opacity: 0;
        text: Glyphs.extra;
    }

    if page == 1: NetworkPage {
        width: parent.width;
        height: parent.height;
        // `root.` everywhere: inside an element, a bare `net` would mean
        // the element's OWN property of that name (binding it to itself).
        net: root.net;
        networks: root.networks;
        scanning: root.scanning;
        message: root.net-message;
        message-is-error: root.net-message-is-error;
        back => {
            page = 0;
        }
        scan => {
            wifi-scan();
        }
        pick(n) => {
            if (net.wifi-connected && n.ssid == net.wifi-ssid) {
                // Already on it: nothing to do.
                return;
            }
            join-ssid = n.ssid;
            password = "";
            join-message = "";
            net-message = "";
            if (n.secure) {
                page = 2;
            } else {
                // An open network needs no password.
                busy = true;
                wifi-connect(n.ssid, "");
            }
        }
        forget => {
            net-message = "";
            wifi-forget();
        }
        change-country => {
            country-code = "";
            country-message = "";
            page = 3;
        }
    }

    if page == 2: PasswordPage {
        width: parent.width;
        height: parent.height;
        ssid: root.join-ssid;
        // Two-way: the keyboard types into the window's `password`.
        password <=> root.password;
        masked: mask(root.password);
        busy: root.busy;
        message: root.join-message;
        back => {
            password = "";
            page = 1;
        }
        backspace => {
            password = drop-last(password);
        }
        connect => {
            join-message = "";
            busy = true;
            wifi-connect(join-ssid, password);
        }
    }

    if page == 3: CountryPage {
        width: parent.width;
        height: parent.height;
        current: root.net.wifi-country;
        code <=> root.country-code;
        message: root.country-message;
        back => {
            page = 1;
        }
        backspace => {
            country-code = drop-last(country-code);
        }
        save => {
            set-country(country-code);
        }
    }

    // Drawn last = on top of everything above, covering the whole window.
    // `if`: the welcome screen only exists while the condition holds; once
    // the backend has answered, it's removed for good (along with its
    // timer).
    if !ever-connected: WelcomeScreen {
        width: parent.width;
        height: parent.height;
        slow: starting-slow;
    }
}
