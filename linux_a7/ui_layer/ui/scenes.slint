// scenes.slint -- scenes on the touchscreen (issue #47): the list (run,
// delete) and "Save current state" (pick devices, name it).
//
// A scene is a named set of device settings ("Movie": TV on, lamp at 20 %).
// backend_daemon keeps them (automations.rs) and runs them; this screen
// only lists them and passes taps on, like everything in ui_layer. Making
// one here is deliberately simple: the devices are captured as they are
// right now -- set the lights the way you like, then save that. Anything
// finer (steps by hand, automations) comes from the app or hub_ws.py.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PageHeader, ActionButton, Choice } from "common.slint";
import { Keyboard } from "keyboard.slint";

// One scene, as the list shows it.
export struct SceneItem {
    id: string,
    name: string,
    // e.g. "3 devices"
    detail: string,
}

// A device that can be part of a scene ("Save current state").
export struct PickItem {
    id: string,
    name: string,
    // What would be saved, e.g. "On, 30 %, 2700 K" / "Off".
    detail: string,
    selected: bool,
}

// The name being typed: like a text field (the keyboard below types).
component NameField inherits Rectangle {
    in property <string> text;
    height: Theme.touch-height;
    border-radius: Theme.radius-medium;
    background: Theme.surface;
    border-width: 2px;
    border-color: Theme.accent;
    Text {
        x: Theme.space-l;
        width: parent.width - 2 * Theme.space-l;
        text: root.text + "|";
        color: Theme.text;
        font-size: Theme.font-heading;
        vertical-alignment: center;
        overflow: elide;
    }
}

// The scenes, each with Run and Delete (which asks first).
export component ScenesPage inherits Rectangle {
    in property <[SceneItem]> scenes;
    // What happened last ("Cozy: done", or why it failed); `ok` colours it.
    in property <string> message;
    in property <bool> message-ok: true;
    // The id of a scene being run (its button says so).
    in property <string> running;
    callback back();
    callback run(string);
    callback delete(string);
    callback new-scene();

    // The scene whose Delete was tapped once: tap again to delete.
    property <string> confirm-delete;

    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;

        PageHeader {
            title: "Scenes";
            back => {
                confirm-delete = "";
                root.back();
            }
        }

        if message != "": Text {
            text: message;
            color: message-ok ? Theme.ok : Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        if scenes.length == 0: Text {
            text: "No scenes yet. Set your devices the way you like them (lights dimmed, TV on), then save that as a scene.";
            color: Theme.text-muted;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        ListView {
            vertical-stretch: 1;
            for scene in scenes: Rectangle {
                height: Theme.touch-height + Theme.space-l * 2;
                VerticalLayout {
                    padding-bottom: Theme.space-s;
                    Rectangle {
                        border-radius: Theme.radius-medium;
                        background: Theme.surface;
                        HorizontalLayout {
                            padding-left: Theme.space-l;
                            padding-right: Theme.space-s;
                            spacing: Theme.space-s;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: scene.name;
                                    color: Theme.text;
                                    font-size: Theme.font-subtitle;
                                    overflow: elide;
                                }
                                Text {
                                    text: scene.detail;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-caption;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                ActionButton {
                                    text: confirm-delete == scene.id ? "Delete?" : "Delete";
                                    destructive: confirm-delete == scene.id;
                                    clicked => {
                                        if (confirm-delete == scene.id) {
                                            confirm-delete = "";
                                            root.delete(scene.id);
                                        } else {
                                            confirm-delete = scene.id;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                ActionButton {
                                    text: running == scene.id ? "Running\u{2026}" : "Run";
                                    primary: true;
                                    enabled: running == "";
                                    clicked => {
                                        confirm-delete = "";
                                        root.run(scene.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        ActionButton {
            text: "Save current state as a scene";
            primary: scenes.length == 0;
            clicked => {
                confirm-delete = "";
                root.new-scene();
            }
        }
    }

    // A "Delete?" not confirmed in time goes back to "Delete".
    Timer {
        interval: 4s;
        running: confirm-delete != "";
        triggered => {
            confirm-delete = "";
        }
    }
}

// "Save current state": 0 = pick the devices, 1 = name the scene.
export component CaptureScenePage inherits Rectangle {
    in property <[PickItem]> devices;
    // How many are picked (main.rs counts, from the list itself).
    in property <int> selected-count;
    in-out property <string> name;
    in property <string> message;
    in property <bool> busy;
    callback back();
    callback toggle(int);
    callback backspace();
    callback save();

    property <int> view: 0;

    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;

        PageHeader {
            title: view == 0 ? "New scene" : "Name the scene";
            back => {
                if (view == 1) {
                    view = 0;
                } else {
                    root.back();
                }
            }
        }

        // ---- 0: which devices ----
        if view == 0: Text {
            text: "Which devices should the scene set? Each is saved as it is now.";
            color: Theme.text-muted;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        if view == 0: ListView {
            vertical-stretch: 1;
            for device[index] in devices: Rectangle {
                height: Theme.touch-height + Theme.space-l * 2;
                VerticalLayout {
                    padding-bottom: Theme.space-s;
                    Rectangle {
                        border-radius: Theme.radius-medium;
                        background: device.selected ? Theme.surface-pressed : Theme.surface;
                        border-width: device.selected ? 2px : 0px;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: Theme.space-l;
                            padding-right: Theme.space-l;
                            spacing: Theme.space-m;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: device.name;
                                    color: Theme.text;
                                    font-size: Theme.font-subtitle;
                                    overflow: elide;
                                }
                                Text {
                                    text: device.detail;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-caption;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: device.selected ? "\u{2713}" : "";
                                color: Theme.accent;
                                font-size: Theme.font-heading;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.toggle(index);
                            }
                        }
                    }
                }
            }
        }
        if view == 0: ActionButton {
            text: selected-count == 0 ? "Pick at least one device" : "Next";
            primary: true;
            enabled: selected-count > 0;
            clicked => {
                view = 1;
            }
        }

        // ---- 1: its name ----
        if view == 1: NameField {
            text: root.name;
        }
        if view == 1 && message != "": Text {
            text: message;
            color: Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        if view == 1 && busy: Text {
            text: "Saving\u{2026}";
            color: Theme.text-muted;
            font-size: Theme.font-body;
        }
        if view == 1: Rectangle {
            vertical-stretch: 1;
        }
        if view == 1: Keyboard {
            text <=> root.name;
            max-length: 64;
            backspace => {
                root.backspace();
            }
            done => {
                if (root.name != "" && !busy) {
                    root.save();
                }
            }
        }
    }

    // A new visit starts at the first view (main.rs clears the picks).
    changed devices => {
        view = 0;
    }
}
