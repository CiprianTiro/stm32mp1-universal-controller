// wizard.slint -- adding and setting up devices on the touchscreen (issue
// #40).
//
// The wizard itself runs in backend_daemon (its wizard.rs): it knows the
// steps, checks every answer and talks to the device. These pages only
// DRAW the step backend_daemon sent and report what was tapped or typed;
// main.rs turns that into wizard_answer / wizard_back / wizard_finish. So
// there is no code here for "a WLED" or "a TV" -- one page draws every
// step type, for every device type.
//
//   AddDevicePage   "Found on your network" (one tap to add) and the
//                   device types that can be added
//   WizardPage      the current step: text, a pick-list, fields (typed on
//                   the on-screen keyboard), "accept on the device" with a
//                   countdown, "Testing...", then name and room
//   DevicePage      one device's details: change settings, pair again,
//                   remove

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PageHeader, ActionButton, Choice } from "common.slint";
import { Keyboard } from "keyboard.slint";
import { Toggle, ModeItem } from "devices.slint";

// A device type the wizard can add.
export struct TemplateItem {
    id: string,
    name: string,
    // "Lighting", "TV & media", ...
    category: string,
    description: string,
}

// A device found on the network, not added yet.
export struct FoundItem {
    template: string,
    name: string,
    address: string,
    // The device type's name, e.g. "WLED light".
    type-name: string,
}

// One choice of a choice field.
export struct ChoiceItem {
    value: string,
    label: string,
}

// One input of the current step, as the page draws it.
export struct FieldItem {
    id: string,
    label: string,
    hint: string,
    // "text", "number", "secret", "choice", "toggle"
    kind: string,
    // What's shown in the box: the value, dots for a secret, or "".
    shown: string,
    // The raw value (a choice's selected value).
    value: string,
    required: bool,
    choices: [ChoiceItem],
}

// Another way into the same device type ("Enter the address").
export struct VariantItem {
    id: string,
    label: string,
}

// A section title in a list.
component SectionTitle inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-body;
}

// A tappable row with a title and a detail line.
component PickRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> action: "";
    callback clicked();

    height: Theme.touch-height + Theme.space-l + Theme.space-xxs;
    border-radius: Theme.radius-medium;
    background: touch.pressed ? Theme.surface-pressed : Theme.surface;

    HorizontalLayout {
        padding-left: Theme.space-xl;
        padding-right: Theme.space-xl;
        spacing: Theme.space-m;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: title;
                color: Theme.text;
                font-size: Theme.font-subtitle;
                overflow: elide;
            }
            if detail != "": Text {
                text: detail;
                color: Theme.text-muted;
                font-size: Theme.font-caption;
                overflow: elide;
            }
        }
        if action != "": Text {
            text: action;
            color: Theme.accent;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component AddDevicePage inherits Rectangle {
    in property <[FoundItem]> found;
    in property <[TemplateItem]> templates;
    in property <string> message;
    callback back();
    callback add-found(string, string);
    callback pick-template(string);
    callback search();

    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;

        PageHeader {
            title: "Add a device";
            back => {
                root.back();
            }
        }

        if message != "": Text {
            text: message;
            color: Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.space-s;
                // Top-aligned: the ScrollView gives its content at least
                // its own height, which would otherwise be shared out
                // between the rows.
                alignment: start;
                HorizontalLayout {
                    spacing: Theme.space-m;
                    SectionTitle {
                        text: found.length == 0 ? "Nothing new found on your network" : "Found on your network";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    ActionButton {
                        text: "Search again";
                        clicked => {
                            root.search();
                        }
                    }
                }
                for f in found: PickRow {
                    title: f.name;
                    detail: f.type-name + ", " + f.address;
                    action: "Add";
                    clicked => {
                        root.add-found(f.template, f.address);
                    }
                }
                SectionTitle {
                    text: "Or choose the type of device";
                }
                // By category (backend_daemon sends them sorted by it): a
                // heading wherever the category changes.
                for t[i] in templates: VerticalLayout {
                    spacing: Theme.space-s;
                    if i == 0 || templates[i - 1].category != t.category: Text {
                        text: t.category;
                        color: Theme.text;
                        font-size: Theme.font-subtitle;
                    }
                    PickRow {
                        title: t.name;
                        detail: t.description;
                        clicked => {
                            root.pick-template(t.id);
                        }
                    }
                }
            }
        }
    }
}

// One field: its label, the value box (tap to type), and its hint. Choice
// and toggle fields are buttons instead of a box.
component FieldRow inherits VerticalLayout {
    // Only as tall as its content: spare height must not open gaps
    // between the label and its box.
    vertical-stretch: 0;
    alignment: start;
    in property <FieldItem> field;
    in property <bool> editing;
    // While editing: what's typed so far (dots for a secret, unless
    // revealed).
    in property <string> live;
    // A secret shown in plain text ("Show" tapped), so a long code like an
    // IR blaster's pairing code can be checked before sending (issue #42).
    in property <bool> reveal;
    callback edit();
    callback pick(string);
    callback toggle-reveal();

    spacing: Theme.space-xxs;

    Text {
        text: field.label + (field.required ? "" : " (optional)");
        color: Theme.text-muted;
        font-size: Theme.font-body;
    }
    if field.kind == "choice": HorizontalLayout {
        spacing: Theme.space-s;
        for c in field.choices: Choice {
            text: c.label;
            selected: c.value == field.value;
            clicked => {
                root.pick(c.value);
            }
        }
    }
    if field.kind == "toggle": HorizontalLayout {
        spacing: Theme.space-s;
        Choice {
            text: "On";
            selected: field.value == "true";
            clicked => {
                root.pick("true");
            }
        }
        Choice {
            text: "Off";
            selected: field.value != "true";
            clicked => {
                root.pick("false");
            }
        }
    }
    if field.kind != "choice" && field.kind != "toggle": Rectangle {
        height: Theme.touch-height;
        border-radius: Theme.radius-medium;
        background: Theme.surface;
        border-width: editing ? 2px : 1px;
        border-color: editing ? Theme.accent : Theme.outline;
        // A secret has a Show / Hide switch on the right.
        property <length> reveal-width: field.kind == "secret" ? 72px : 0;
        Text {
            x: Theme.space-l;
            width: parent.width - 2 * Theme.space-l - reveal-width;
            // "|": a simple cursor while typing into it.
            text: (editing ? live : (field.kind == "secret" && reveal ? field.value : field.shown)) + (editing ? "|" : "");
            color: Theme.text;
            font-size: Theme.font-heading;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea {
            clicked => {
                root.edit();
            }
        }
        if field.kind == "secret": Rectangle {
            x: parent.width - reveal-width;
            width: reveal-width;
            height: parent.height;
            Text {
                text: reveal ? "Hide" : "Show";
                color: Theme.accent;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // On top of the box's own TouchArea (declared later), so a tap
            // here only switches, it doesn't start typing.
            TouchArea {
                clicked => {
                    root.toggle-reveal();
                }
            }
        }
    }
    if field.hint != "": Text {
        text: field.hint;
        color: Theme.text-muted;
        font-size: Theme.font-caption;
        wrap: word-wrap;
    }
}

export component WizardPage inherits Rectangle {
    // E.g. "Add: WLED light", "Pair again: Living room TV".
    in property <string> title;
    // backend_daemon's step type: "info", "discover", "form", "choice",
    // "confirm_on_device", "code_from_device", "provision_ble", "test",
    // "name", "save"; a vendor account login (#74) as "login" (email),
    // "login_code" (the code it sent) and "login_pick" (its devices, in
    // `found`: address = the vendor's id, type-name = the line below).
    in property <string> step;
    in property <int> number;
    // info: the text; confirm_on_device: the hint; name/save: what the
    // test found ("WLED 16.0.1").
    in property <string> text;
    // confirm_on_device: more hints, shown one after the other.
    in property <[string]> hints;
    // confirm_on_device: how long the device waits for the person.
    in property <int> seconds;
    in property <[FoundItem]> found;
    in property <[FieldItem]> fields;
    // The template's other ways in (discover step).
    in property <[VariantItem]> variants;
    // Which field is being typed into (-1: none) and what's typed so far.
    in property <int> editing: -1;
    in-out property <string> edit-text;
    // edit-text as the field shows it (masked for a secret; app.slint).
    in property <string> edit-shown;
    // Secrets shown in plain text (FieldRow's Show / Hide). main.rs hides
    // them again at every new step.
    in-out property <bool> reveal: false;
    // The last refused answer: the sentence, and its technical detail.
    in property <string> error;
    in property <string> detail;
    // Waiting for backend_daemon (a test, the device's confirmation).
    in property <bool> busy;
    // The main button's text ("Next", "Add", "Save").
    in property <string> primary-text: "Next";
    callback back();
    callback next();
    callback retry();
    callback pick-found(string);
    callback search();
    callback edit(int);
    callback pick(int, string);
    callback edit-done();
    callback backspace();
    callback switch-variant(string);

    // confirm_on_device: the countdown and which hint shows.
    property <int> left: seconds;
    property <int> hint-index: 0;
    changed busy => {
        left = seconds;
        hint-index = 0;
    }
    Timer {
        interval: 1s;
        running: busy && (step == "confirm_on_device" || step == "provision_ble") && left > 0;
        triggered => {
            left -= 1;
            // A new hint every 8 s.
            if (hints.length > 0 && Math.mod(seconds - left, 8) == 0) {
                hint-index = Math.mod(hint-index + 1, hints.length);
            }
        }
    }

    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;

        PageHeader {
            title: root.title;
            back => {
                root.back();
            }
        }

        Text {
            text: "Step " + number;
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }

        if error != "": VerticalLayout {
            spacing: Theme.space-xxs;
            vertical-stretch: 0;
            Text {
                text: error;
                color: Theme.error;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }
            if detail != "": Text {
                text: detail;
                color: Theme.text-muted;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }
        }

        // ---- the step ----
        if step == "info": Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-subtitle;
            wrap: word-wrap;
        }

        if step == "discover": ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.space-s;
                alignment: start;
                Text {
                    text: found.length == 0 ? "Looking for devices on your network\u{2026}" : "Tap your device:";
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                }
                for f in found: PickRow {
                    title: f.name;
                    detail: f.address;
                    clicked => {
                        root.pick-found(f.address);
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    alignment: start;
                    ActionButton {
                        text: "Search again";
                        clicked => {
                            root.search();
                        }
                    }
                    for v in variants: ActionButton {
                        text: v.label;
                        clicked => {
                            root.switch-variant(v.id);
                        }
                    }
                }
            }
        }

        // A vendor login: what it's for, or where the code went.
        if (step == "login" || step == "login_code" || step == "login_pick") && root.text != "": Text {
            text: root.text;
            color: Theme.text-muted;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        // A vendor login (#74): accounts the hub is signed in to already --
        // one tap, no password.
        if step == "login" && found.length > 0: VerticalLayout {
            spacing: Theme.space-s;
            vertical-stretch: 0;
            for f in found: PickRow {
                title: f.name;
                detail: f.type-name;
                clicked => {
                    root.pick-found(f.address);
                }
            }
            Text {
                text: "Or sign in with another account:";
                color: Theme.text-muted;
                font-size: Theme.font-caption;
            }
        }

        if step == "login_pick": ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.space-s;
                alignment: start;
                for f in found: PickRow {
                    title: f.name;
                    detail: f.type-name;
                    clicked => {
                        root.pick-found(f.address);
                    }
                }
            }
        }

        if step == "form" || step == "choice" || step == "code_from_device" || step == "name" || step == "login" || step == "login_code": VerticalLayout {
            spacing: Theme.space-l;
            vertical-stretch: 0;
            // While typing, only the field being typed into: with the
            // keyboard open, several fields don't fit on the touchscreen
            // (#74: a camera's four). The others come back at "Done".
            for f[i] in fields: VerticalLayout {
                if root.editing < 0 || i == root.editing: FieldRow {
                    field: f;
                    editing: i == root.editing;
                    live: root.edit-shown;
                    reveal: root.reveal;
                    toggle-reveal => {
                        root.reveal = !root.reveal;
                    }
                    edit => {
                        root.edit(i);
                    }
                    pick(value) => {
                        root.pick(i, value);
                    }
                }
            }
        }

        if step == "confirm_on_device" || step == "provision_ble": VerticalLayout {
            spacing: Theme.space-m;
            vertical-stretch: 0;
            Text {
                text: root.text;
                color: Theme.text;
                font-size: Theme.font-heading;
                wrap: word-wrap;
            }
            if busy && hints.length > 0: Text {
                text: hints[hint-index];
                color: Theme.text-muted;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }
            if busy: Text {
                text: "Waiting\u{2026} " + left + " s";
                color: Theme.accent;
                font-size: Theme.font-subtitle;
            }
        }

        if (step == "login" || step == "login_code" || step == "login_pick") && busy: Text {
            text: "Talking to the vendor\u{2026}";
            color: Theme.accent;
            font-size: Theme.font-subtitle;
        }

        if step == "test" && busy: Text {
            text: "Testing the connection\u{2026}";
            color: Theme.accent;
            font-size: Theme.font-subtitle;
        }

        if step == "save": Text {
            text: (root.text == "" ? "" : "Found: " + root.text + ". ") + "Save the changes?";
            color: Theme.text;
            font-size: Theme.font-subtitle;
            wrap: word-wrap;
        }
        if step == "name" && root.text != "": Text {
            text: "Found: " + root.text;
            color: Theme.ok;
            font-size: Theme.font-body;
        }

        // Fill the rest, so the buttons or keyboard sit at the bottom --
        // except on the discover step, whose list takes that space.
        if step != "discover" && step != "login_pick": Rectangle {
            vertical-stretch: 1;
        }

        // ---- bottom: the keyboard while typing, else the buttons ----
        if editing >= 0: Keyboard {
            text <=> root.edit-text;
            max-length: 128;
            backspace => {
                root.backspace();
            }
            done => {
                root.edit-done();
            }
        }

        if editing < 0 && !busy: HorizontalLayout {
            spacing: Theme.space-s;
            alignment: end;
            vertical-stretch: 0;
            // A test or pairing that failed: try again (the step stays).
            if error != "" && (step == "test" || step == "confirm_on_device" || step == "provision_ble"): ActionButton {
                text: "Try again";
                primary: true;
                clicked => {
                    root.retry();
                }
            }
            // A vendor login: another email, or a new code.
            if step == "login_code" || step == "login_pick": ActionButton {
                text: "Start over";
                clicked => {
                    root.search();
                }
            }
            if step == "info" || step == "form" || step == "code_from_device" || step == "name" || step == "save" || step == "login" || step == "login_code": ActionButton {
                text: root.primary-text;
                primary: true;
                clicked => {
                    root.next();
                }
            }
        }
    }
}

// One device's details and what can be done with it.
export component DevicePage inherits Rectangle {
    in property <string> name;
    in property <string> room;
    in property <string> type-name;
    // "Online", "Offline", "Needs pairing again", or "".
    in property <string> status;
    in property <bool> can-reauth;
    in property <bool> can-reconfigure;
    in property <bool> can-remove;
    in property <string> message;
    // The device has a remote (a TV, an IR blaster device), and whether its
    // buttons are taught (issue #42).
    in property <bool> has-remote;
    in property <bool> remote-learns;
    // The rooms the hub's devices are in, offered as one-tap choices when
    // the device moves.
    in property <[string]> rooms;
    // What the on-screen keyboard types (bound to app.slint, whose
    // drop-last does the keyboard's backspace).
    in-out property <string> edit-text;
    // ---- Issue #99: "Powered by" a plug (an IR device) ----
    in property <bool> can-power-link;
    // The plug's id ("" = none), whether switching off cuts it, how long
    // the device needs after power-on (s); the row's line ("EZVIZ plug
    // \u{2022} confirmed by power").
    in property <string> power-plug;
    in property <bool> power-cut;
    in property <int> power-delay;
    in property <string> power-summary;
    // The plugs it can be linked to (value = id, label = name), and
    // whether the linked one measures power (then it can be learned).
    in property <[ModeItem]> plugs;
    in property <bool> power-measures;
    // "Off 0.4 W \u{2022} on 6 W: confirmed by power", or "" = not learned.
    in property <string> power-learned;
    // A learning step's result or problem; a step is running.
    in property <string> power-status;
    in property <bool> power-busy;
    callback save-power(string, bool, int);
    callback learn-power(string);
    callback back();
    callback open-remote();
    callback reauth();
    callback reconfigure();
    callback remove();
    // Name and room changed: (name, room); room "" = no room.
    callback save-info(string, string);
    callback backspace();

    // "Remove" asks once more before it happens.
    property <bool> confirm-remove: false;
    // "Name and room": the editor instead of the list; what's being typed
    // (0 nothing, 1 the name, 2 a new room); the values being edited.
    property <bool> editing-info: false;
    property <int> typing: 0;
    property <string> new-name;
    property <string> new-room;
    // new-room was typed (not one of `rooms`): its box shows it.
    property <bool> custom-room: false;
    // "Powered by": its editor instead of the list (in-out: main.rs
    // closes it when a device page opens), and the values being edited.
    in-out property <bool> editing-power: false;
    property <string> new-plug;
    property <bool> new-cut;
    property <int> new-delay;
    // Opened (by the row, or from outside -- also already open when the
    // page is made): starts from what's saved.
    function start-power-edit() {
        new-plug = power-plug;
        new-cut = power-cut;
        new-delay = power-delay;
    }
    changed editing-power => {
        if (editing-power) {
            start-power-edit();
        }
    }
    init => {
        if (editing-power) {
            start-power-edit();
        }
    }

    background: Theme.background;

    // ---- the name and room editor ----
    if editing-info: VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;

        PageHeader {
            title: "Name and room";
            back => {
                if (typing != 0) {
                    typing = 0;
                } else {
                    editing-info = false;
                }
            }
        }
        Text {
            text: "Name";
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }
        Rectangle {
            height: Theme.touch-height;
            border-radius: Theme.radius-medium;
            border-width: typing == 1 ? 2px : 1px;
            border-color: typing == 1 ? Theme.accent : Theme.outline;
            background: Theme.surface;
            Text {
                x: Theme.space-m;
                text: typing == 1 ? root.edit-text : root.new-name;
                color: Theme.text;
                font-size: Theme.font-subtitle;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.edit-text = root.new-name;
                    typing = 1;
                }
            }
        }
        Text {
            text: "Room";
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }
        // The rooms in use, "No room", and one that's new: tap to pick.
        // Scrolls when there are many.
        if typing == 0: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.space-xs;
                alignment: start;
                for r in rooms: Choice {
                    text: r;
                    selected: !root.custom-room && root.new-room == r;
                    clicked => {
                        root.new-room = r;
                        root.custom-room = false;
                    }
                }
                Choice {
                    text: "No room";
                    selected: !root.custom-room && root.new-room == "";
                    clicked => {
                        root.new-room = "";
                        root.custom-room = false;
                    }
                }
            }
        }
        Rectangle {
            height: Theme.touch-height;
            border-radius: Theme.radius-medium;
            border-width: typing == 2 || custom-room ? 2px : 1px;
            border-color: typing == 2 || custom-room ? Theme.accent : Theme.outline;
            background: Theme.surface;
            Text {
                x: Theme.space-m;
                text: typing == 2 ? root.edit-text : custom-room ? root.new-room : "A new room\u{2026}";
                color: typing == 2 || custom-room ? Theme.text : Theme.text-muted;
                font-size: Theme.font-subtitle;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.edit-text = custom-room ? root.new-room : "";
                    typing = 2;
                }
            }
        }
        if typing != 0: Rectangle {
            vertical-stretch: 1;
        }
        if typing != 0: Keyboard {
            text <=> root.edit-text;
            max-length: 40;
            backspace => {
                root.backspace();
            }
            done => {
                if (typing == 1) {
                    root.new-name = root.edit-text;
                } else if (root.edit-text != "") {
                    root.new-room = root.edit-text;
                    root.custom-room = true;
                }
                typing = 0;
            }
        }
        if typing == 0: HorizontalLayout {
            spacing: Theme.space-s;
            alignment: end;
            ActionButton {
                text: "Cancel";
                clicked => {
                    editing-info = false;
                }
            }
            ActionButton {
                text: "Save";
                primary: true;
                clicked => {
                    editing-info = false;
                    root.save-info(root.new-name, root.new-room);
                }
            }
        }
    }

    // ---- "Powered by" (issue #99) ----
    if editing-power: VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;

        PageHeader {
            title: "Powered by";
            back => {
                editing-power = false;
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.space-s;
                alignment: start;
                Text {
                    text: "The plug " + root.name + " is plugged into. Switching it on switches the plug on first; a plug that's off means it's off.";
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
                for p in plugs: Choice {
                    text: p.label;
                    selected: root.new-plug == p.value;
                    clicked => {
                        root.new-plug = p.value;
                    }
                }
                Choice {
                    text: "No plug";
                    selected: root.new-plug == "";
                    clicked => {
                        root.new-plug = "";
                    }
                }
                if root.new-plug != "": HorizontalLayout {
                    spacing: Theme.space-m;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: "Cut the power when off";
                            color: Theme.text;
                            font-size: Theme.font-subtitle;
                        }
                        Text {
                            text: "No standby power. Needed if it has no Off or Power button.";
                            color: Theme.text-muted;
                            font-size: Theme.font-caption;
                            wrap: word-wrap;
                        }
                    }
                    Toggle {
                        y: (parent.height - self.height) / 2;
                        on: root.new-cut;
                        toggled(on) => {
                            root.new-cut = on;
                        }
                    }
                }
                if root.new-plug != "": Text {
                    text: "Time it needs after the power comes on";
                    color: Theme.text-muted;
                    font-size: Theme.font-caption;
                }
                if root.new-plug != "": HorizontalLayout {
                    spacing: Theme.space-xs;
                    for d in [1, 2, 5, 10, 30]: Choice {
                        text: d + " s";
                        selected: root.new-delay == d;
                        clicked => {
                            root.new-delay = d;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    alignment: end;
                    ActionButton {
                        text: "Close";
                        clicked => {
                            editing-power = false;
                        }
                    }
                    // Linked: stays open, so learning (below) can follow.
                    ActionButton {
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.save-power(root.new-plug, root.new-cut, root.new-delay);
                            if (root.new-plug == "") {
                                editing-power = false;
                            }
                        }
                    }
                }

                // Learning (a saved link to a plug that measures): the
                // person makes sure it's off, the hub measures; then the
                // hub switches it on and measures.
                if root.power-plug != "" && root.power-measures: VerticalLayout {
                    spacing: Theme.space-s;
                    padding-top: Theme.space-l;
                    Text {
                        text: "Know when it's really on";
                        color: Theme.text;
                        font-size: Theme.font-subtitle;
                    }
                    Text {
                        text: root.power-learned != "" ? root.power-learned
                            : "Not learned: the hub assumes what it last sent. Learn what " + root.name + " draws, and its state follows the plug's measurement -- also when someone uses its own remote.";
                        color: root.power-learned != "" ? Theme.ok : Theme.text-muted;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "1. Make sure " + root.name + " is OFF (use its remote if needed), then:";
                        color: Theme.text;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                    ActionButton {
                        text: "Measure off";
                        clicked => {
                            if (!root.power-busy) {
                                root.learn-power("off");
                            }
                        }
                    }
                    Text {
                        text: "2. The hub switches it on and measures:";
                        color: Theme.text;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                    ActionButton {
                        text: "Switch on and measure";
                        clicked => {
                            if (!root.power-busy) {
                                root.learn-power("on");
                            }
                        }
                    }
                    if root.power-status != "": Text {
                        text: root.power-status;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                    if root.power-learned != "": ActionButton {
                        text: "Forget what was learned";
                        clicked => {
                            if (!root.power-busy) {
                                root.learn-power("forget");
                            }
                        }
                    }
                }
            }
        }
    }

    if !editing-info && !editing-power: VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;
        alignment: start;

        PageHeader {
            title: root.name;
            back => {
                confirm-remove = false;
                root.back();
            }
        }
        Text {
            text: type-name + (room == "" ? "" : ", " + room);
            color: Theme.text-muted;
            font-size: Theme.font-body;
        }
        if status != "": Text {
            text: status;
            color: status == "Online" ? Theme.ok : Theme.error;
            font-size: Theme.font-subtitle;
        }
        if message != "": Text {
            text: message;
            color: Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        PickRow {
            title: "Name and room";
            detail: "When it moves, or for a better name";
            clicked => {
                confirm-remove = false;
                root.new-name = root.name;
                root.new-room = root.room;
                root.custom-room = false;
                typing = 0;
                editing-info = true;
            }
        }
        if can-power-link: PickRow {
            title: "Powered by";
            detail: root.power-summary;
            clicked => {
                confirm-remove = false;
                editing-power = true;
            }
        }
        if has-remote: PickRow {
            title: "Remote";
            detail: remote-learns ? "Its buttons, and teaching new ones" : "Buttons, apps and channels";
            clicked => {
                confirm-remove = false;
                root.open-remote();
            }
        }
        if can-reconfigure: PickRow {
            title: "Change settings";
            detail: "A new address, a changed password";
            clicked => {
                root.reconfigure();
            }
        }
        if can-reauth: PickRow {
            title: "Pair again";
            detail: "When the device no longer accepts the hub";
            clicked => {
                root.reauth();
            }
        }
        if can-remove: ActionButton {
            text: confirm-remove ? "Tap again to remove " + root.name : "Remove device";
            destructive: true;
            clicked => {
                if (confirm-remove) {
                    confirm-remove = false;
                    root.remove();
                } else {
                    confirm-remove = true;
                }
            }
        }
    }
}
